<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- ReactiveUI.Avalonia 12.1.2 是官方对齐 Avalonia 12 的那条线（nuspec 直接锁 12.1.2 + ReactiveUI 24.2.0）。
         注意：NuGet 上的 14.7.1 是错位包（元数据仍是 Splat，依赖停在 ReactiveUI 19.4.1），不要用。 -->
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <ReactiveUIVersion>24.2.0</ReactiveUIVersion>
    <ReactiveUIAvaloniaVersion>12.1.2</ReactiveUIAvaloniaVersion>
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CodeWF.Avalonia.Controls" Version="12.1.4.21" />
    <PackageVersion Include="CodeWF.Toolkit.Core" Version="1.0.0.19" />
    <PackageVersion Include="CodeWF.Toolkit.Lang" Version="1.0.0.19" />
    <PackageVersion Include="CodeWF.Avalonia.Lang" Version="12.1.4.21" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageVersion Include="Irihi.Ursa" Version="2.2.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />

    <PackageVersion Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftExtensionsVersion)" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>
</Project>
