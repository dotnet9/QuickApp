<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts\</ArtifactsPath>
    <PackageOutputPath>$(ArtifactsPath)packages\</PackageOutputPath>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 不能开 InvariantGlobalization：App.axaml 的 SemiTheme 传 Locale="zh-CN"，
         SemiTheme 的静态构造会 new CultureInfo("zh-CN")，Invariant 模式直接抛
         CultureNotFoundException，AOT 版窗口都建不起来（详见 docs/DEVELOPMENT.md） -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>zh-Hans</NeutralLanguage>

    <!-- 版本号单一来源；CI 发布时用 -p:Version=<tag> 覆盖 -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.9.12</VersionPrefix>
    <Company>QuickApp</Company>
    <Product>QuickApp 快捷应用</Product>
    <Authors>Dotnet9</Authors>
    <RepositoryUrl>https://github.com/dotnet9/QuickApp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
