<?xml version="1.0" encoding="utf-8"?>
<!--
  Linux x64 发布配置。
  注意：NativeAOT 不支持从 Windows 交叉链接到 Linux（需要 Linux 上的 clang/lld），
  这条配置的用途是在 Linux 机器或 GitHub Actions 的 ubuntu runner 上发布。
  另外当前应用面向 net10.0-windows（Win32 互操作 + HKCU + Shell 图标），
  要真正产出可用的 Linux 版，需要先把 app 项目改成多目标并做平台抽象。
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\PublishProfile.Common.props" />
</Project>
