<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    自己写 ControlTheme 而不用 Fluent 的按钮模板：
    原型上的圆角、悬停放大、按下缩放都要精确控制，主题模板会把 Background/CornerRadius 盖掉。
    颜色全部走 ThemeDictionaries 资源（对应原型 CSS token），深/浅主题变体各一套，
    设置窗口切浅色时按钮悬停/选中才不会用白色叠加消失在白卡上。
  -->

  <!-- 全局字体：原型 font token 的中文字体优先 -->
  <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>

  <!-- 原型浮层（菜单/气泡）圆角 10~11，Fluent 用 OverlayCornerRadius 统一控制弹层 -->
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="QATextBrush" Color="#EEF1F6" />
      <SolidColorBrush x:Key="QATextDimBrush" Color="#9AA4B3" />
      <SolidColorBrush x:Key="QALineBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="QAHoverBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="QAActiveBrush" Color="#29FFFFFF" />
      <SolidColorBrush x:Key="QAMenuHoverBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="QAMenuBrush" Color="#FA181B21" />
      <SolidColorBrush x:Key="QAAccentBrush" Color="#5AA2FF" />
      <SolidColorBrush x:Key="QAAccentInkBrush" Color="#08111F" />
      <SolidColorBrush x:Key="QADangerBrush" Color="#FF6B6B" />
      <SolidColorBrush x:Key="QARemoveBgBrush" Color="#CC0B0E13" />
      <SolidColorBrush x:Key="QATileShadowBrush" Color="#47000000" />
      <!-- Fluent 菜单资源的原型覆盖：菜单底/悬停对应 menu-bg / menu-hover token -->
      <SolidColorBrush x:Key="MenuFlyoutBackground" Color="#FA181B21" />
      <SolidColorBrush x:Key="MenuFlyoutBorderBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="QAResultRowBrush" Color="#4D1A1D24" />
      <SolidColorBrush x:Key="QAAccentSoftBorderBrush" Color="#805AA2FF" />
      <SolidColorBrush x:Key="MenuItemBackground" Color="#00181818" />
      <SolidColorBrush x:Key="MenuItemBackgroundPointerOver" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="MenuItemBackgroundPressed" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="MenuItemForeground" Color="#EEF1F6" />
      <SolidColorBrush x:Key="MenuItemForegroundPointerOver" Color="#EEF1F6" />
      <!-- ComboBox 下拉弹层跟随主题（原生默认浅底浅字不可读） -->
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FA181B21" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1FFFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="QATextBrush" Color="#111826" />
      <SolidColorBrush x:Key="QATextDimBrush" Color="#5C6675" />
      <SolidColorBrush x:Key="QALineBrush" Color="#1F111826" />
      <SolidColorBrush x:Key="QAHoverBrush" Color="#0F111826" />
      <SolidColorBrush x:Key="QAActiveBrush" Color="#1F111826" />
      <SolidColorBrush x:Key="QAMenuHoverBrush" Color="#0F111826" />
      <SolidColorBrush x:Key="QAMenuBrush" Color="#FDFFFFFF" />
      <SolidColorBrush x:Key="QAAccentBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="QAAccentInkBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="QADangerBrush" Color="#D92D20" />
      <SolidColorBrush x:Key="QARemoveBgBrush" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="QATileShadowBrush" Color="#26111826" />
      <SolidColorBrush x:Key="MenuFlyoutBackground" Color="#FDFFFFFF" />
      <SolidColorBrush x:Key="MenuFlyoutBorderBrush" Color="#1F111826" />
      <SolidColorBrush x:Key="QAResultRowBrush" Color="#4DFFFFFF" />
      <SolidColorBrush x:Key="QAAccentSoftBorderBrush" Color="#802563EB" />
      <SolidColorBrush x:Key="MenuItemBackground" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="MenuItemBackgroundPointerOver" Color="#0F111826" />
      <SolidColorBrush x:Key="MenuItemBackgroundPressed" Color="#1F111826" />
      <SolidColorBrush x:Key="MenuItemForeground" Color="#111826" />
      <SolidColorBrush x:Key="MenuItemForegroundPointerOver" Color="#111826" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FDFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1F111826" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Dock 上的一个图标 -->
  <ControlTheme x:Key="TileButton" TargetType="Button">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
          <TransformOperationsTransition.Easing>
            <BackEaseOut />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Bg"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border Name="PART_Hover"
                  Background="{DynamicResource QAHoverBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border Name="PART_Press"
                  Background="#14000000"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0" />
          <ContentPresenter Name="PART_Content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Hover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Press">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!-- Dock 右侧的操作按钮 / 窗口上的小按钮：32x32 圆角方块（原型 .icon-btn 32px r9） -->
  <ControlTheme x:Key="IconButton" TargetType="Button">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAActiveBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <Style Selector="^.active /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
    </Style>
    <!-- 激活态（钉住/搜索打开）：图标用强调色，对应原型 .icon-btn.active 的 accent 前景 -->
    <Style Selector="^.active">
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="^.low-priority">
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="^.low-priority:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^.low-priority:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <!-- 编辑模式里图标右上角的移除按钮：原型 .remove 17px 圆底白 ×，悬停危险色并放大 1.12 -->
  <ControlTheme x:Key="RemoveButton" TargetType="Button">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                Background="{DynamicResource QARemoveBgBrush}"
                CornerRadius="9"
                BoxShadow="0 1 3 0 #66000000">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14">
          <TransformOperationsTransition.Easing>
            <BackEaseOut />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QADangerBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.12)" />
    </Style>
  </ControlTheme>

  <!-- 分段选择（设置窗口的主题/风格/停靠边）：选中项用强调色填充，对应原型的 seg -->
  <ControlTheme x:Key="Segment" TargetType="Button">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                Background="Transparent"
                CornerRadius="7"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
    </Style>
    <Style Selector="^.active /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="^.active">
      <Setter Property="Foreground" Value="{DynamicResource QAAccentInkBrush}" />
    </Style>
  </ControlTheme>

  <!-- 文字按钮（设置窗口里的「打开所在目录」「立即检查」等），对应原型 .chip：r8、悬停加深、primary 强调色填充 -->
  <ControlTheme x:Key="LinkButton" TargetType="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="{DynamicResource QAHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAActiveBrush}" />
    </Style>
    <Style Selector="^.primary /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Foreground" Value="{DynamicResource QAAccentInkBrush}" />
    </Style>
  </ControlTheme>

  <!-- 设置窗口的开关：原型 .switch 38x22 r11，滑块 16，选中强调色 -->
  <ControlTheme x:Key="QASwitch" TargetType="ToggleButton">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track"
                CornerRadius="11"
                Background="{DynamicResource QAHoverBrush}"
                BorderBrush="{DynamicResource QALineBrush}"
                BorderThickness="1">
          <Ellipse Name="PART_Knob"
                   Width="16"
                   Height="16"
                   Margin="2,2,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource QATextDimBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Ellipse#PART_Knob">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource QAActiveBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Knob">
      <Setter Property="Fill" Value="White" />
      <Setter Property="RenderTransform" Value="translateX(16px)" />
    </Style>
  </ControlTheme>

  <!-- 设置窗口左侧导航的标签：原型 .settings-tab 38px 高，选中强调色 + 左缘 3px 白色缺口条 -->
  <ControlTheme x:Key="QATabItem" TargetType="TabItem">
    <Setter Property="Height" Value="38" />
    <!-- 原型 .settings-nav 136px（border-box）：135 给标签 + 1px 右缘分隔线，选中块不压线 -->
    <Setter Property="MinWidth" Value="135" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Height="38" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
            <Border Name="PART_Notch"
                    Width="3"
                    Height="24"
                    Margin="-18,0,9,0"
                    HorizontalAlignment="Left"
                    CornerRadius="0,3,3,0"
                    IsVisible="False"
                    Background="{DynamicResource QAAccentInkBrush}"
                    Opacity="0.7" />
            <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAActiveBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Notch">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource QAAccentInkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </ControlTheme>

  <!-- 菜单项：原型 .menu-item 30px 高 r7，图标 16 淡色，danger 红色，右侧 mi-note 徽章 -->
  <ControlTheme x:Key="QAMenuItem" TargetType="MenuItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg"
                MinHeight="30"
                Background="Transparent"
                CornerRadius="7">
          <Grid ColumnDefinitions="Auto,Auto"
                ColumnSpacing="9"
                VerticalAlignment="Center"
                Margin="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_Icon"
                              Grid.Column="0"
                              Content="{TemplateBinding Icon}"
                              VerticalAlignment="Center" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Header}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextElement.FontSize="{TemplateBinding FontSize}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAMenuHoverBrush}" />
    </Style>
    <!-- 分组标题：menu-title 11px 淡色，不响应悬停 -->
    <Style Selector="^.title">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="^.title /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="0,7,0,5" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{DynamicResource QADangerBrush}" />
    </Style>
  </ControlTheme>

  <!-- 停靠位置四向选择器的边按钮：悬停淡底，选中强调色（原型 .dock-pos .edge） -->
  <ControlTheme x:Key="EdgePickButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bg" Background="{TemplateBinding Background}" CornerRadius="7">
          <!-- Stretch：边区药丸要沿按钮长边拉伸（原型 .edge::before 的 58%），
               Center 会让无显式尺寸的药丸塌缩为 0 -->
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAMenuHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="^.active /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="^.active">
      <Setter Property="Foreground" Value="{DynamicResource QAAccentInkBrush}" />
    </Style>
  </ControlTheme>


  <!-- Toast 动作按钮（原型 .toast .toast-action）：纯强调色文字，无底色无内边距 -->
  <ControlTheme x:Key="ToastActionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
