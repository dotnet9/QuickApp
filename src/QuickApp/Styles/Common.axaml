<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 全局共用的少量样式；Dock 自己的样式放在 DockWindow.Styles 里 -->

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,12,0,4" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.row">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================ 菜单 / 设置页导航（原型对齐） ============================ -->

  <!-- 使用约定：MenuItem 加 Classes="menu-item" 应用 QAMenuItem 主题；分组标题再加 "title" -->
  <Style Selector="MenuItem.menu-item">
    <Setter Property="Theme" Value="{DynamicResource QAMenuItem}" />
  </Style>

  <!-- 菜单容器：原型 .menu min-width 87 / padding 6 / r11；宽度由内容自然撑开 -->
  <Style Selector="ContextMenu">
    <Setter Property="MinWidth" Value="87" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="MinWidth" Value="87" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>

  <!-- 菜单分隔线：原型 .menu-sep 1px，边距 5 8 -->
  <Style Selector="Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,5" />
    <Setter Property="Background" Value="{DynamicResource QALineBrush}" />
  </Style>

  <!-- 菜单图标：16px 描边，颜色随主题（danger 由菜单项级联覆盖） -->
  <Style Selector="Path.mi-icon">
    <Setter Property="StrokeThickness" Value="1.75" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <!-- 菜单右侧徽章：原型 .mi-note 11px 淡色 -->
  <Style Selector="TextBlock.menu-note">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 设置页导航条：原型 .settings-nav 背景 + 右缘分隔线 -->
  <Style Selector="TabControl.settings-tabs TabStrip">
    <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- 设置页标签使用 QATabItem 主题 -->
  <Style Selector="TabItem.settings-tab">
    <Setter Property="Theme" Value="{DynamicResource QATabItem}" />
  </Style>

  <!-- 开关（ToggleButton + Classes="switch"）应用 QASwitch 主题 -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Theme" Value="{DynamicResource QASwitch}" />
  </Style>

  <!-- 停靠四向选择器边按钮应用 EdgePickButton 主题 -->
  <Style Selector="Button.edge-pick">
    <Setter Property="Theme" Value="{DynamicResource EdgePickButton}" />
  </Style>

  <!-- ============================ 主题内图标颜色 ============================ -->
  <!-- 这些后代选择器不能放进 ControlTheme（会抛"child or descendent selector"异常，
       v0.2.5 点「更多操作」崩溃即此因），统一放全局样式按类匹配 -->
  <Style Selector="MenuItem.menu-item Path.mi-icon">
    <Setter Property="Stroke" Value="{DynamicResource QATextDimBrush}" />
  </Style>
  <Style Selector="MenuItem.menu-item.danger Path.mi-icon">
    <Setter Property="Stroke" Value="{DynamicResource QADangerBrush}" />
  </Style>
  <Style Selector="TabItem.settings-tab Path.tab-icon">
    <Setter Property="Stroke" Value="{DynamicResource QATextDimBrush}" />
  </Style>
  <Style Selector="TabItem.settings-tab:selected Path.tab-icon">
    <Setter Property="Stroke" Value="{DynamicResource QAAccentInkBrush}" />
  </Style>

  <!-- ============================ ComboBox（设置页目标显示器等） ============================ -->
  <!-- 下拉弹层底色由 ThemeDictionaries 的 ComboBoxDropDownBackground/BorderBrush 覆盖 -->
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
  </Style>

  <!-- 更新条按钮（原型 .update-actions .chip）：高 24 / padding 0,9 / 字号 11.5 -->
  <Style Selector="Button.update-chip">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- 搜索结果＋按钮（原型 .search-result-add）：30 r9；悬停 accent 填充、图形转墨色 -->
  <Style Selector="Button.add-btn">
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Button.add-btn:pointerover /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
  </Style>
  <Style Selector="Button.add-btn:pointerover /template/ ContentPresenter Path">
    <Setter Property="Stroke" Value="{DynamicResource QAAccentInkBrush}" />
  </Style>
</Styles>
