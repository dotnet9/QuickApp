<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.DockWindow"
        x:DataType="vm:DockViewModel"
        Title="QuickApp"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Blur,Transparent">

  <Window.Resources>
    <!-- 一个图标：图标 + 名称（名称按设置显隐），左/右边缘时自动变成横向排列 -->
    <DataTemplate x:Key="TileTemplate" x:DataType="vm:ItemViewModel">
      <StackPanel Orientation="{Binding ItemOrientation}" Spacing="5" Margin="1">

        <Border Name="TileRoot"
                Classes="tile"
                Classes.edit="{Binding ShowRemove}"
                Classes.renaming="{Binding IsRenaming}"
                Classes.droptarget="{Binding IsDropTarget}"
                Width="{Binding TileSize}"
                Height="{Binding TileSize}"
                CornerRadius="{Binding TileRadius}"
                Background="{Binding IconBrush}"
                BorderBrush="{Binding RingBrush}"
                BorderThickness="2"
                ToolTip.Tip="{Binding Tooltip}"
                DragDrop.AllowDrop="True">
          <Panel>
            <!-- 真实图标（从 exe/lnk 提取并缓存） -->
            <Image Source="{Binding Icon}"
                   Width="{Binding IconSize}"
                   Height="{Binding IconSize}"
                   IsVisible="{Binding HasIcon}"
                   Stretch="Uniform" />

            <!-- 没有真实图标时的占位：类型相关的线性图标 + 底色 -->
            <Path Data="{Binding Glyph}"
                  IsVisible="{Binding !HasIcon}"
                  Stroke="White"
                  StrokeThickness="1.7"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="{Binding IconSize}"
                  Height="{Binding IconSize}" />

            <!-- 执行中的反馈 -->
            <Path Data="M5,12.5 L9.5,17 L19,7"
                  IsVisible="{Binding IsRunning}"
                  Stroke="White"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="{Binding TileSize}"
                  Height="{Binding TileSize}" />

            <!-- 编辑模式：移除 -->
            <Button Theme="{StaticResource RemoveButton}"
                    Width="18"
                    Height="18"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowRemove}"
                    Command="{Binding RemoveCommand}"
                    ToolTip.Tip="移除">
              <Path Data="M6,6 L18,18 M18,6 L6,18"
                    Stroke="White"
                    StrokeThickness="2.4"
                    StrokeLineCap="Round"
                    Width="9"
                    Height="9"
                    Stretch="Uniform" />
            </Button>
          </Panel>
        </Border>

        <!-- 就地改名：名称位置换成输入框（回车提交、Esc 取消、失焦提交） -->
        <TextBox Classes="rename"
                 Name="RenameBox"
                 Text="{Binding EditingName}"
                 IsVisible="{Binding IsRenaming}"
                 Width="100"
                 Height="24"
                 FontSize="11"
                 HorizontalAlignment="Center" />

        <TextBlock Classes="label"
                   Text="{Binding Name}"
                   IsVisible="{Binding ShowNameText}"
                   MaxWidth="96"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 图标方块：悬停放大、拖动落点半透明、改名时淡出 -->
    <Style Selector="Border.tile">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.1)" />
    </Style>
    <Style Selector="Border.tile.droptarget">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.tile.renaming">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.tile.edit">
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>
  </Window.Styles>

  <!-- 外留白：给悬停放大与阴影留出空间 -->
  <Grid Margin="8">
    <Border Name="Panel"
            Background="{Binding PanelBrush}"
            BorderBrush="{Binding PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding PanelRadius}"
            Padding="8,4,8,6">
      <StackPanel Orientation="Vertical" Spacing="2">

        <!-- 搜索行 -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              IsVisible="{Binding IsSearchOpen}"
              Margin="4,2,4,4">
          <Path Grid.Column="0"
                Data="M10,3 C13.87,3 17,6.13 17,10 C17,13.87 13.87,17 10,17 C6.13,17 3,13.87 3,10 C3,6.13 6.13,3 10,3 Z M15.2,15.2 L21,21"
                Stroke="{Binding TextDimBrush}"
                StrokeThickness="1.8"
                StrokeLineCap="Round"
                Width="15"
                Height="15"
                Stretch="Uniform"
                VerticalAlignment="Center"
                Margin="2,0,6,0" />
          <TextBox Grid.Column="1"
                   Name="SearchBox"
                   Text="{Binding SearchQuery}"
                   PlaceholderText="搜索应用、网址、命令…"
                   FontSize="13"
                   Background="Transparent"
                   BorderThickness="0" />
          <TextBlock Grid.Column="2"
                     Text="{Binding CountText}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="6,0"
                     Foreground="{Binding TextDimBrush}" />
          <Button Grid.Column="3"
                  Theme="{StaticResource IconButton}"
                  Width="26"
                  Height="26"
                  Command="{Binding ClearSearchCommand}"
                  ToolTip.Tip="清空搜索">
            <Path Data="M6,6 L18,18 M18,6 L6,18"
                  Stroke="{Binding TextDimBrush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  Width="10"
                  Height="10"
                  Stretch="Uniform" />
          </Button>
        </Grid>

        <!-- 搜索无结果 -->
        <TextBlock IsVisible="{Binding IsSearchEmpty}"
                   Text="没有匹配的项目"
                   FontSize="12"
                   Margin="12,10"
                   Foreground="{Binding TextDimBrush}" />

        <!-- 主体：图标条 | 分隔线 | 操作区（左/右边缘时整列改成竖向） -->
        <StackPanel Orientation="{Binding BodyOrientation}" Spacing="8">

          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        MaxWidth="{Binding ListMaxWidth}"
                        MaxHeight="{Binding ListMaxHeight}">
            <ItemsControl Name="ItemsHost"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource TileTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="{Binding ListOrientation}" Spacing="{Binding ListSpacing}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>

          <Border Width="{Binding DividerWidth}"
                  Height="{Binding DividerHeight}"
                  Background="{Binding PanelBorderBrush}" />

          <!-- 操作区：全部图形按钮（图标在视图层由代码塞进去） -->
          <StackPanel Orientation="{Binding BodyOrientation}" Spacing="2" VerticalAlignment="Center">
            <Button Theme="{StaticResource IconButton}" Name="MoveButton" ToolTip.Tip="按住拖到任意一边吸附" />
            <Button Theme="{StaticResource IconButton}" Name="SearchButton" Command="{Binding ToggleSearchCommand}" ToolTip.Tip="搜索（S）" />
            <Button Theme="{StaticResource IconButton}" Name="EditButton" Command="{Binding ToggleEditCommand}" ToolTip.Tip="编辑模式（E）" />
            <Button Theme="{StaticResource IconButton}" Name="AddButton" ToolTip.Tip="添加文件" />
            <Button Theme="{StaticResource IconButton}" Name="MoreButton" ToolTip.Tip="更多" />
            <Button Theme="{StaticResource IconButton}" Name="PinButton" Command="{Binding TogglePinCommand}" ToolTip.Tip="钉住 Dock" />
            <Button Theme="{StaticResource IconButton}" Name="CollapseButton" Command="{Binding HideCommand}" ToolTip.Tip="收起" />
          </StackPanel>
        </StackPanel>

        <!-- 更新提示 -->
        <Border IsVisible="{Binding UpdateAvailable}"
                Background="{Binding HoverBrush}"
                CornerRadius="8"
                Padding="8,4"
                Margin="2,2,2,0">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding UpdateText}" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Content="去下载"
                    Command="{Binding OpenUpdateCommand}" Margin="8,0" />
            <Button Grid.Column="2" Theme="{StaticResource LinkButton}" Content="忽略"
                    Command="{Binding DismissUpdateCommand}" />
          </Grid>
        </Border>

        <!-- 编辑模式工具条 -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditMode}" Margin="6,2,6,0">
          <TextBlock Text="拖动排序 · 双击改名 · 点 × 移除"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Foreground="{Binding TextDimBrush}" />
          <Button Theme="{StaticResource LinkButton}" Content="完成" Command="{Binding ToggleEditCommand}" />
        </StackPanel>

        <!-- 提示条 -->
        <TextBlock IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Margin="6,2,6,0"
                   Foreground="{Binding TextDimBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
