<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.DockWindow"
        x:DataType="vm:DockViewModel"
        Title="QuickApp"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Resources>
    <!-- 一个图标：图标 + 名称（名称按设置显隐），左/右边缘时自动变成横向排列 -->
    <DataTemplate x:Key="TileTemplate" x:DataType="vm:ItemViewModel">
      <StackPanel Orientation="{Binding ItemOrientation}" Spacing="5" Margin="1" ClipToBounds="False">

        <Border Name="TileRoot"
                Classes="tile"
                Classes.edit="{Binding ShowRemove}"
                Classes.renaming="{Binding IsRenaming}"
                Classes.dragged="{Binding IsDragged}"
                Classes.droptarget="{Binding IsDropTarget}"
                Width="{Binding TileSize}"
                Height="{Binding TileSize}"
                CornerRadius="{Binding TileCornerRadius}"
                ClipToBounds="True"
                Background="{Binding IconBrush}"
                BorderBrush="{Binding RingBrush}"
                BorderThickness="2"
                ToolTip.Tip="{Binding Tooltip}"
                DragDrop.AllowDrop="True">
          <Panel>
            <!-- 真实图标（从 exe/lnk 提取并缓存） -->
            <Image Source="{Binding Icon}"
                   Width="{Binding IconSize}"
                   Height="{Binding IconSize}"
                   IsVisible="{Binding HasIcon}"
                   Stretch="Uniform" />

            <!-- 没有真实图标时的占位：类型相关的线性图标 + 底色 -->
            <Path Data="{Binding Glyph}"
                  IsVisible="{Binding !HasIcon}"
                  Stroke="White"
                  StrokeThickness="1.7"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="{Binding IconSize}"
                  Height="{Binding IconSize}" />

            <!-- 执行中的反馈 -->
            <Path Data="M5,12.5 L9.5,17 L19,7"
                  IsVisible="{Binding IsRunning}"
                  Stroke="White"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="{Binding TileSize}"
                  Height="{Binding TileSize}" />

            <!-- 编辑模式：移除。横向 Dock 在左上角、竖向 Dock 在右上角，向外偏 3px（原型 .remove） -->
            <Button Theme="{StaticResource RemoveButton}"
                    Classes="remove"
                    Classes.removeLeft="{Binding !IsItemVertical}"
                    Margin="0,-3,-3,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowRemove}"
                    Command="{Binding RemoveCommand}"
                    ToolTip.Tip="移除">
              <Path Data="M6,6 L18,18 M18,6 L6,18"
                    Stroke="White"
                    StrokeThickness="2.4"
                    StrokeLineCap="Round"
                    Width="9"
                    Height="9"
                    Stretch="Uniform" />
            </Button>
          </Panel>
        </Border>

        <!-- 就地改名：名称位置换成输入框（回车提交、Esc 取消、失焦提交），对应原型 .rename-input -->
        <TextBox Classes="rename"
                 Name="RenameBox"
                 Text="{Binding EditingName}"
                 IsVisible="{Binding IsRenaming}"
                 Width="{Binding RenameWidth}"
                 Height="32"
                 FontSize="13"
                 TextAlignment="Center"
                 Background="{DynamicResource QAMenuBrush}"
                 BorderBrush="{DynamicResource QAAccentBrush}"
                 BorderThickness="1"
                 CornerRadius="8"
                 Foreground="{DynamicResource QATextBrush}"
                 HorizontalAlignment="Center" />

        <TextBlock Classes="label"
                   Text="{Binding Name}"
                   IsVisible="{Binding ShowNameText}"
                   MaxWidth="{Binding LabelMaxWidth}"
                   Foreground="{Binding TextBrush}"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- 搜索到但尚未加入 Dock 的系统应用：保留结果分组，并提供明确的添加动作。 -->
    <DataTemplate x:Key="InstalledTemplate" x:DataType="vm:ItemViewModel">
      <Border Background="{DynamicResource QAHoverBrush}"
              BorderBrush="{DynamicResource QALineBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="6"
              Margin="1"
              Width="220"
              Cursor="Hand"
              PointerPressed="OnInstalledResultPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
          <Border Width="36"
                  Height="36"
                  CornerRadius="{Binding TileCornerRadius}"
                  Background="{Binding IconBrush}"
                  ClipToBounds="True"
                  VerticalAlignment="Center">
            <Panel>
              <Image Source="{Binding Icon}"
                     IsVisible="{Binding HasIcon}"
                     Stretch="Uniform"
                     Margin="7" />
              <Path Data="{Binding Glyph}"
                    IsVisible="{Binding !HasIcon}"
                    Stroke="White"
                    StrokeThickness="1.6"
                    Stretch="Uniform"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Name}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ResultStatus}"
                       FontSize="10"
                       Foreground="{Binding TextBrush}"
                       Opacity="0.72"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2"
                  Theme="{StaticResource LinkButton}"
                  Classes="primary"
                  Width="30"
                  Height="28"
                  Padding="0"
                  Command="{Binding AddToDockCommand}"
                  ToolTip.Tip="添加到 Dock">
            <TextBlock Text="＋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- 默认只显示透明的图标区；搜索或编辑时恢复完整操作面板。 -->
    <Style Selector="Border.dock-panel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.dock-panel.expanded">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{Binding PanelCornerRadius}" />
      <Setter Property="Padding" Value="10,4,10,6" />
      <Setter Property="BoxShadow" Value="0 8 20 0 #66000000, 0 2 8 0 #44000000, inset 0 1 0 0 #1AFFFFFF" />
    </Style>

    <Style Selector="Border.action-panel">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BoxShadow" Value="0 6 16 0 #3D000000" />
    </Style>
    <Style Selector="Border.action-panel.expanded">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 图标方块：悬停朝桌面内部弹出（带回弹），避免贴边裁切。 -->
    <Style Selector="Border.tile">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #47000000" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26">
            <TransformOperationsTransition.Easing>
              <BackEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="RenderTransform" Value="{Binding HoverTransform, x:DataType=vm:ItemViewModel}" />
      <Setter Property="BoxShadow" Value="0 14 28 0 #6B000000, 0 3 8 0 #42000000" />
      <Setter Property="Panel.ZIndex" Value="1" />
    </Style>
    <Style Selector="Border.tile.pressed">
      <Setter Property="RenderTransform" Value="{Binding PressedTransform, x:DataType=vm:ItemViewModel}" />
    </Style>
    <Style Selector="Border.tile.dragged">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.tile.renaming">
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- 移除按钮：横向 Dock 在左上（原型 .remove 的 left:-3px） -->
    <Style Selector="Button.remove.removeLeft">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-3,-3,0,0" />
    </Style>
    <Style Selector="Border.tile.edit">
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>

    <!-- 气泡/工具提示：对应原型 .bubble（菜单底色 + 1px 边线 + r10） -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource QAMenuBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="11,7" />
    </Style>
  </Window.Styles>

  <!-- 外留白：投影空间（逐像素透明窗下阴影与桌面正确混合） -->
  <Grid Margin="12">
    <Border Name="Panel"
            Classes="dock-panel"
            Classes.expanded="{Binding IsPanelExpanded}"
            ClipToBounds="False"
            >
      <StackPanel Orientation="Vertical" Spacing="2">

        <!-- 搜索行 -->
        <StackPanel IsVisible="{Binding IsSearchOpen}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                Margin="4,2,4,4">
            <Path Grid.Column="0"
                  Data="M10,3 C13.87,3 17,6.13 17,10 C17,13.87 13.87,17 10,17 C6.13,17 3,13.87 3,10 C3,6.13 6.13,3 10,3 Z M15.2,15.2 L21,21"
                  Stroke="{Binding TextDimBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  Width="15"
                  Height="15"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="2,0,6,0" />
            <TextBox Grid.Column="1"
                     Name="SearchBox"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="搜索应用、网址、命令…"
                     FontSize="13"
                     Background="Transparent"
                     BorderThickness="0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding CountText}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="6,0"
                       Foreground="{Binding TextDimBrush}" />
            <Button Grid.Column="3"
                    Theme="{StaticResource IconButton}"
                    Width="26"
                    Height="26"
                    Command="{Binding ToggleSearchCommand}"
                    ToolTip.Tip="关闭搜索">
              <Path Data="M6,6 L18,18 M18,6 L6,18"
                    Stroke="{Binding TextDimBrush}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    Width="10"
                    Height="10"
                    Stretch="Uniform" />
            </Button>
          </Grid>
          <!-- 搜索行下边线（原型 .dock-search 的 border-bottom） -->
          <Border Height="1" Margin="2,0,2,2" Background="{Binding PanelBorderBrush}" />
        </StackPanel>

        <!-- 主体：图标条 | 分隔线 | 操作区（左/右边缘时整列改成竖向） -->
        <StackPanel Orientation="{Binding BodyOrientation}" Spacing="8">

          <!-- 图标区滚动 chrome：滚动条隐藏，用两端渐隐 + 强调色指示条（原型 .fade/.scroll-indicator） -->
          <Grid Name="ScrollArea"
                MaxWidth="{Binding ListMaxWidth}"
                MaxHeight="{Binding ListMaxHeight}"
                MinWidth="{Binding ListMinWidth}"
                MinHeight="{Binding ListMinHeight}">
            <ScrollViewer Name="ItemsScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          Padding="{Binding ListPadding}"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Top">
              <StackPanel Orientation="Vertical"
                          Spacing="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                <TextBlock Text="{Binding ConfiguredGroupTitle}"
                           IsVisible="{Binding HasConfiguredResults}"
                           FontSize="10"
                           Foreground="{Binding TextDimBrush}"
                           Margin="4,2,4,0" />
                <ItemsControl Name="ItemsHost"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource TileTemplate}"
                              ClipToBounds="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="{Binding ListOrientation}" Spacing="{Binding ListSpacing}" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding InstalledGroupTitle}"
                           IsVisible="{Binding HasInstalledResults}"
                           FontSize="10"
                           Foreground="{Binding TextDimBrush}"
                           Margin="4,4,4,0" />
                <ItemsControl Name="InstalledItemsHost"
                              ItemsSource="{Binding InstalledItems}"
                              ItemTemplate="{StaticResource InstalledTemplate}"
                              ClipToBounds="False">
                  <ItemsControl.IsVisible>
                    <Binding Path="HasInstalledResults" />
                  </ItemsControl.IsVisible>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" Spacing="4" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- 空状态属于图标区，保持左侧视口和右侧操作区的布局稳定。 -->
            <TextBlock IsVisible="{Binding IsSearchEmpty}"
                       Text="{Binding EmptyStateText}"
                       FontSize="12"
                       Margin="18,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{Binding TextDimBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />

            <TextBlock IsVisible="{Binding IsDockEmpty}"
                       Text="{Binding EmptyStateText}"
                       FontSize="12"
                       Margin="18,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{Binding TextDimBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       IsHitTestVisible="False" />

            <!-- 两端渐隐：轴向随停靠边，位置与显隐由视图按滚动位置计算 -->
            <Border Name="FadeStart" IsHitTestVisible="False" IsVisible="False" />
            <Border Name="FadeEnd" IsHitTestVisible="False" IsVisible="False" />

            <!-- 滚动指示条 -->
            <Border Name="ScrollIndicator"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Background="{Binding HoverBrush}"
                    CornerRadius="2"
                    Margin="24,0,24,4">
              <Border Name="ScrollThumb"
                      Background="{Binding AccentBrush}"
                      Opacity="0.65"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" />
            </Border>
          </Grid>

          <!-- 操作区：独立的轻量面板，默认不抢应用图标的视觉重点。 -->
          <Border Name="ActionPanel"
                  Classes="action-panel"
                  Classes.expanded="{Binding IsPanelExpanded}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Orientation="{Binding BodyOrientation}" Spacing="3">
              <Border Width="{Binding DividerWidth}"
                      Height="{Binding DividerHeight}"
                      Background="{Binding PanelBorderBrush}" />

              <WrapPanel Orientation="Horizontal"
                         ItemWidth="28"
                         ItemHeight="28"
                         MaxWidth="{Binding ActionMaxWidth}"
                         MaxHeight="{Binding ActionMaxHeight}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center">
                <Button Theme="{StaticResource IconButton}" Name="SearchButton" Width="28" Height="28" Command="{Binding ToggleSearchCommand}" ToolTip.Tip="搜索（S）" />
                <Button Theme="{StaticResource IconButton}" Name="AddButton" Width="28" Height="28" ToolTip.Tip="添加文件或命令行" />
                <Button Theme="{StaticResource IconButton}" Name="PinButton" Width="28" Height="28" Command="{Binding TogglePinCommand}" ToolTip.Tip="钉住 Dock" />
                <Button Theme="{StaticResource IconButton}" Name="MoreButton" Width="28" Height="28" ToolTip.Tip="更多操作" />
                <Button Theme="{StaticResource IconButton}" Classes="low-priority" Name="CollapseButton" Width="28" Height="28" Command="{Binding HideCommand}" ToolTip.Tip="收起" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 更新提示 -->
        <Border IsVisible="{Binding UpdateAvailable}"
                Background="{Binding HoverBrush}"
                CornerRadius="8"
                Padding="8,4"
                Margin="2,2,2,0">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Column="0" Text="{Binding UpdateText}" FontSize="12" VerticalAlignment="Center" />
              <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Content="下载"
                      IsVisible="{Binding CanDownloadUpdate}"
                      Command="{Binding DownloadUpdateCommand}" Margin="8,0" />
              <Button Grid.Column="2" Theme="{StaticResource LinkButton}" Content="{Binding UpdateInstallButtonText}"
                      IsVisible="{Binding IsUpdateReady}"
                      Command="{Binding InstallUpdateCommand}" Margin="8,0" />
              <Button Grid.Column="3" Theme="{StaticResource LinkButton}" Content="打开发布页"
                      IsVisible="{Binding NeedsUpdatePage}"
                      Command="{Binding OpenUpdateCommand}" Margin="8,0" />
              <Button Grid.Column="4" Theme="{StaticResource LinkButton}" Content="取消"
                      IsVisible="{Binding IsDownloadingUpdate}"
                      Command="{Binding CancelUpdateDownloadCommand}" Margin="8,0" />
              <Button Grid.Column="4" Theme="{StaticResource LinkButton}" Content="忽略"
                      IsVisible="{Binding !IsDownloadingUpdate}"
                      Command="{Binding DismissUpdateCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDownloadingUpdate}">
              <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"
                           Height="4" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding DownloadProgressText}" FontSize="11"
                         Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock IsVisible="{Binding IsUpdateReady}"
                       Text="{Binding DownloadProgressText}" FontSize="11" />
          </StackPanel>
        </Border>

        <!-- 编辑模式工具条（原型 .dock-editbar：上边线 + 12px 提示 + primary 完成钮） -->
        <StackPanel IsVisible="{Binding IsEditMode}" Margin="8,2,8,2">
          <Border Height="1" Margin="2,0,2,6" Background="{Binding PanelBorderBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="拖动排序 · 双击改名 · 点 × 移除"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{Binding TextDimBrush}" />
            <Button Theme="{StaticResource LinkButton}" Classes="primary" Content="完成" Command="{Binding ToggleEditCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
