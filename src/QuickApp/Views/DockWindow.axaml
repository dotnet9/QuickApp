<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.DockWindow"
        x:DataType="vm:DockViewModel"
        Title="QuickApp"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Resources>
    <!-- 一个图标：图标 + 名称（名称按设置显隐），左/右边缘时自动变成横向排列 -->
    <DataTemplate x:Key="TileTemplate" x:DataType="vm:ItemViewModel">
      <StackPanel Orientation="{Binding ItemOrientation}" Spacing="{Binding ItemLabelSpacing}" Margin="0" ClipToBounds="False">

        <Border Name="TileRoot"
                Classes="tile"
                Classes.edit="{Binding ShowRemove}"
                Classes.renaming="{Binding IsRenaming}"
                Classes.dragged="{Binding IsDragged}"
                Classes.droptarget="{Binding IsDropTarget}"
                Width="{Binding TileSize}"
                Height="{Binding TileSize}"
                CornerRadius="{Binding TileCornerRadius}"
                ClipToBounds="True"
                Background="{Binding TileBackgroundBrush}"
                BorderBrush="{Binding RingBrush}"
                BorderThickness="0"
                ToolTip.Tip="{Binding Tooltip}"
                Focusable="True"
                DragDrop.AllowDrop="True">
          <Panel>
            <!-- 真实图标（从 exe/lnk 提取并缓存） -->
            <Image Source="{Binding Icon}"
                   Width="{Binding IconSize}"
                   Height="{Binding IconSize}"
                   IsVisible="{Binding HasIcon}"
                   Stretch="Uniform" />

            <!-- 没有真实图标时的占位：类型相关的线性图标（应用类透明底 + 正文色，原型 .tile.app-icon） -->
            <Path Data="{Binding Glyph}"
                  IsVisible="{Binding !HasIcon}"
                  Stroke="{Binding TextBrush}"
                  StrokeThickness="1.7"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="{Binding GlyphSize}"
                  Height="{Binding GlyphSize}" />

            <!-- 执行中的反馈 -->
            <Path Data="M5,12.5 L9.5,17 L19,7"
                  IsVisible="{Binding IsRunning}"
                  Stroke="{Binding TextBrush}"
                  StrokeThickness="2.2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="Uniform"
                  Width="{Binding TileSize}"
                  Height="{Binding TileSize}" />

            <Border IsVisible="{Binding IsFocused}"
                    BorderBrush="{Binding RingBrush}"
                    BorderThickness="2"
                    CornerRadius="{Binding TileCornerRadius}"
                    IsHitTestVisible="False" />

            <!-- 编辑模式：移除。横向 Dock 在左上角、竖向 Dock 在右上角，向外偏 3px（原型 .remove） -->
            <Button Theme="{StaticResource RemoveButton}"
                    Classes="remove"
                    Classes.removeLeft="{Binding !IsItemVertical}"
                    Margin="0,-3,-3,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowRemove}"
                    Command="{Binding RemoveCommand}"
                    ToolTip.Tip="移除">
              <Path Data="M6,6 L18,18 M18,6 L6,18"
                    Stroke="{Binding TextBrush}"
                    StrokeThickness="2.6"
                    StrokeLineCap="Round"
                    Width="12"
                    Height="12"
                    Stretch="Uniform" />
            </Button>
          </Panel>
        </Border>

        <!-- 就地改名：名称位置换成输入框（回车提交、Esc 取消、失焦提交），对应原型 .rename-input -->
        <TextBox Classes="rename"
                 Name="RenameBox"
                 Text="{Binding EditingName}"
                 IsVisible="{Binding IsRenaming}"
                 Width="{Binding RenameWidth}"
                 Height="32"
                 FontSize="13"
                 TextAlignment="Center"
                 Background="{DynamicResource QAMenuBrush}"
                 BorderBrush="{DynamicResource QAAccentBrush}"
                 BorderThickness="1"
                 CornerRadius="8"
                 Foreground="{DynamicResource QATextBrush}"
                 HorizontalAlignment="Center" />

        <TextBlock Classes="label"
                   Text="{Binding Name}"
                   IsVisible="{Binding ShowNameText}"
                   MaxWidth="{Binding LabelMaxWidth}"
                   Foreground="{Binding TextBrush}"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- 系统应用行（原型 .search-installed-item）：surface 30% 底、padding 5,7、无固定宽；
         副标题 11px 淡色 + 「未配置」胶囊（10px 强调色 + 50% 描边）；＋ 按钮 30 r9 常态 hover 底。 -->
    <DataTemplate x:Key="InstalledTemplate" x:DataType="vm:ItemViewModel">
      <Border Background="{DynamicResource QAResultRowBrush}"
              BorderBrush="{DynamicResource QALineBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="5,7"
              Cursor="Hand"
              Focusable="True"
              PointerPressed="OnInstalledResultPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
          <Border Width="36"
                  Height="36"
                  CornerRadius="10"
                  Background="Transparent"
                  ClipToBounds="True"
                  VerticalAlignment="Center">
            <Panel>
              <Image Source="{Binding Icon}"
                     IsVisible="{Binding HasIcon}"
                     Width="36"
                     Height="36"
                     Stretch="Uniform" />
              <Path Data="{Binding Glyph}"
                    IsVisible="{Binding !HasIcon}"
                    Stroke="{DynamicResource QATextBrush}"
                    StrokeThickness="1.75"
                    Stretch="Uniform"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding Name}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ResultStatus}"
                       FontSize="11"
                       Foreground="{DynamicResource QATextDimBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <Border IsVisible="{Binding ShowUnconfiguredBadge}"
                    BorderBrush="{DynamicResource QAAccentSoftBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="6,2"
                    HorizontalAlignment="Right">
              <TextBlock Text="未配置" FontSize="10" Foreground="{DynamicResource QAAccentBrush}" />
            </Border>
            <Button Theme="{StaticResource LinkButton}"
                    Classes="add-btn"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Command="{Binding AddToDockCommand}"
                    ToolTip.Tip="添加到 Dock">
              <Path Data="M12,5 L12,19 M5,12 L19,12"
                    Stroke="{DynamicResource QAAccentBrush}"
                    StrokeThickness="2.2"
                    StrokeLineCap="Round"
                    Width="16"
                    Height="16"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- 默认只显示透明的图标区；搜索或编辑时恢复完整操作面板。 -->
    <Style Selector="Border.dock-panel">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="Border.dock-panel.expanded">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{Binding PanelCornerRadius}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BoxShadow" Value="0 18 40 0 #73000000, 0 2 8 0 #59000000, inset 0 1 0 0 #1AFFFFFF" />
    </Style>

    <Style Selector="Border.action-panel">
      <Setter Property="Background" Value="{Binding PanelBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BoxShadow" Value="0 6 16 0 #3D000000" />
    </Style>
    <Style Selector="Border.action-panel.expanded">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>

    <!-- 空状态提示的底板：Dock 面板是透明的，提示文字直接浮在壁纸上，
         浅色壁纸下淡灰字不可读，给它一块近不透明的菜单底色（任意壁纸可读）。 -->
    <Style Selector="Border.empty-pill">
      <Setter Property="Background" Value="{DynamicResource QAMenuBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BoxShadow" Value="0 6 16 0 #3D000000" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 图标方块：悬停朝桌面内部弹出（带回弹），避免贴边裁切。 -->
    <Style Selector="Border.tile">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BoxShadow" Value="0 2 6 0 #47000000" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26">
            <TransformOperationsTransition.Easing>
              <BackEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.tile:pointerover">
      <Setter Property="RenderTransform" Value="{Binding HoverTransform, x:DataType=vm:ItemViewModel}" />
      <Setter Property="BoxShadow" Value="0 14 28 0 #6B000000, 0 3 8 0 #42000000" />
      <Setter Property="Panel.ZIndex" Value="1" />
    </Style>
    <Style Selector="Border.tile.pressed">
      <Setter Property="RenderTransform" Value="{Binding PressedTransform, x:DataType=vm:ItemViewModel}" />
    </Style>
    <Style Selector="Border.tile.dragged">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.tile.renaming">
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- 移除按钮：横向 Dock 在左上（原型 .remove 的 left:-3px） -->
    <Style Selector="Button.remove.removeLeft">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-3,-3,0,0" />
    </Style>
    <Style Selector="Border.tile.edit">
      <Setter Property="Cursor" Value="SizeAll" />
    </Style>

    <!-- 更新条（原型 .update-bar）：面板内一行，min-width 330，文本截断按钮恒右 -->
    <Style Selector="Border.update-bar">
      <Setter Property="Background" Value="{Binding HoverBrush}" />
      <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinWidth" Value="330" />
      <Setter Property="Padding" Value="10,7,8,7" />
      <Setter Property="Margin" Value="2,4,2,0" />
    </Style>

    <!-- 竖排更新胶囊（原型 .update-pill）：强调色描边 + 呼吸圆点语义 -->
    <Style Selector="Button.update-pill">
      <Setter Property="Background" Value="{Binding PillBrush}" />
      <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Foreground" Value="{Binding AccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.update-pill:pointerover">
      <Setter Property="Background" Value="{Binding PillHoverBrush}" />
    </Style>

    <!-- 气泡/工具提示：对应原型 .bubble（菜单底色 + 1px 边线 + r10） -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource QAMenuBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="11,7" />
    </Style>
  
  <!-- 胶囊呼吸点（原型 @keyframes pillBlink：1.6s 透明度 1↔0.35） -->
  <Style Selector="Ellipse.pill-dot">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Window.Styles>

  <!-- 外留白：投影空间（逐像素透明窗下阴影与桌面正确混合） -->
  <Grid Margin="12">
    <Border Name="Panel"
            Classes="dock-panel"
            Classes.expanded="{Binding IsPanelExpanded}"
            ClipToBounds="False"
            >
      <StackPanel Orientation="Vertical" Spacing="2">

        <!-- 搜索行 -->
        <StackPanel IsVisible="{Binding IsSearchOpen}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                Margin="6,4,6,2">
            <Path Grid.Column="0"
                  Data="M10,3 C13.87,3 17,6.13 17,10 C17,13.87 13.87,17 10,17 C6.13,17 3,13.87 3,10 C3,6.13 6.13,3 10,3 Z M15.2,15.2 L21,21"
                  Stroke="{Binding TextDimBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  Width="20"
                  Height="20"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="2,0,6,0" />
            <TextBox Grid.Column="1"
                     Name="SearchBox"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="搜索应用 / 网址 / 命令 / 拼音…"
                     MinWidth="{Binding SearchMinWidth}"
                     Padding="2,6"
                     FontSize="13"
                     Background="Transparent"
                     BorderThickness="0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding CountText}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="6,0"
                       Foreground="{Binding TextDimBrush}" />
            <Button Grid.Column="3"
                    Theme="{StaticResource IconButton}"
                    Width="28"
                    Height="28"
                    Command="{Binding ToggleSearchCommand}"
                    ToolTip.Tip="关闭搜索">
              <Path Data="M6,6 L18,18 M18,6 L6,18"
                    Stroke="{Binding TextDimBrush}"
                    StrokeThickness="1.75"
                    StrokeLineCap="Round"
                    Width="20"
                    Height="20"
                    Stretch="Uniform" />
            </Button>
          </Grid>
          <!-- 搜索行下边线（原型 .dock-search 的 border-bottom） -->
          <Border Height="1" Margin="0,0,0,2" Background="{Binding PanelBorderBrush}" />
        </StackPanel>

        <!-- 主体：图标条 | 分隔线 | 操作区（左/右边缘时整列改成竖向） -->
        <StackPanel Orientation="{Binding BodyOrientation}" Spacing="8">

          <!-- 图标区滚动 chrome：滚动条隐藏，用两端渐隐 + 强调色指示条（原型 .fade/.scroll-indicator） -->
          <Grid Name="ScrollArea"
                MaxWidth="{Binding ListMaxWidth}"
                MaxHeight="{Binding ListMaxHeight}"
                MinWidth="{Binding ListMinWidth}"
                MinHeight="{Binding ListMinHeight}">
            <ScrollViewer Name="ItemsScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          Padding="{Binding ListPadding}"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Top">
              <StackPanel Orientation="Vertical"
                          Spacing="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HasConfiguredResults}" Margin="2,2,2,6">
                  <TextBlock Text="{Binding ConfiguredGroupTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                  <TextBlock Text="{Binding ConfiguredGroupCount}" FontSize="11" Foreground="{Binding TextDimBrush}" Opacity="0.75" />
                </StackPanel>
                <ItemsControl Name="ItemsHost"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource TileTemplate}"
                              ClipToBounds="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="{Binding ListOrientation}" Spacing="{Binding ListSpacing}" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HasInstalledResults}" Margin="2,4,2,6">
                  <TextBlock Text="{Binding InstalledGroupTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                  <TextBlock Text="{Binding InstalledGroupCount}" FontSize="11" Foreground="{Binding TextDimBrush}" Opacity="0.75" />
                </StackPanel>
                <ItemsControl Name="InstalledItemsHost"
                              ItemsSource="{Binding InstalledItems}"
                              ItemTemplate="{StaticResource InstalledTemplate}"
                              ClipToBounds="False">
                  <ItemsControl.IsVisible>
                    <Binding Path="HasInstalledResults" />
                  </ItemsControl.IsVisible>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical" Spacing="4" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- 空状态属于图标区，保持左侧视口和右侧操作区的布局稳定。 -->
            <Border IsVisible="{Binding IsSearchEmpty}"
                    Classes="empty-pill"
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
              <TextBlock Text="{Binding EmptyStateText}"
                         FontSize="12"
                         Foreground="{Binding TextDimBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </Border>

            <Border IsVisible="{Binding IsDockEmpty}"
                    Classes="empty-pill"
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
              <TextBlock Text="{Binding EmptyStateText}"
                         FontSize="12"
                         Foreground="{Binding TextDimBrush}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 两端渐隐：轴向随停靠边，位置与显隐由视图按滚动位置计算 -->
            <Border Name="FadeStart" IsHitTestVisible="False" IsVisible="False" />
            <Border Name="FadeEnd" IsHitTestVisible="False" IsVisible="False" />

            <!-- 滚动指示条 -->
            <Border Name="ScrollIndicator"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Background="{Binding HoverBrush}"
                    CornerRadius="2"
                    Margin="24,0,24,4">
              <Border Name="ScrollThumb"
                      Background="{Binding AccentBrush}"
                      Opacity="0.65"
                      CornerRadius="2"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" />
            </Border>
          </Grid>

          <!-- 操作区：独立的轻量面板，默认不抢应用图标的视觉重点。 -->
          <Border Name="ActionPanel"
                  Classes="action-panel"
                  Classes.expanded="{Binding IsPanelExpanded}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Orientation="{Binding BodyOrientation}" Spacing="{Binding ToolsSpacing}">
              <Border Width="{Binding DividerWidth}"
                      Height="{Binding DividerHeight}"
                      HorizontalAlignment="Center"
                      Background="{Binding PanelBorderBrush}" />

              <WrapPanel Orientation="Horizontal"
                         ItemWidth="28"
                         ItemHeight="28"
                         HorizontalAlignment="Center"
                         MaxWidth="{Binding ActionMaxWidth}"
                         MaxHeight="{Binding ActionMaxHeight}"
                         VerticalAlignment="Center">
                <Button Theme="{StaticResource IconButton}" Name="SearchButton" Width="28" Height="28" Classes.active="{Binding IsSearchOpen}" Command="{Binding ToggleSearchCommand}" ToolTip.Tip="搜索（S）" />
                <Button Theme="{StaticResource IconButton}" Name="PinButton" Width="28" Height="28" Classes.active="{Binding IsPinned}" Command="{Binding TogglePinCommand}" ToolTip.Tip="钉住 Dock">
                  <Path Data="M9.5,3 L14.5,3 L13.7,8.2 L17,11.5 L7,11.5 L10.3,8.2 Z M12,11.5 L12,21"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1.7"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                </Button>
                <Button Theme="{StaticResource IconButton}" Name="MoreButton" Width="28" Height="28" ToolTip.Tip="更多操作" />
                <Button Theme="{StaticResource IconButton}" Classes="low-priority" Name="CollapseButton" Width="28" Height="28" Command="{Binding HideCommand}" ToolTip.Tip="收起" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 更新条（横排，原型 .update-bar）：面板内一行，min-width 330。
             禁用星号列——窗口按内容测宽时星号列会塌缩为 0，把整窗压扁（v0.2.5 缺陷）；
             文本区用 DockPanel 填充 + 截断，按钮恒靠右。 -->
        <Border Classes="update-bar" IsVisible="{Binding ShowUpdateBar}">
          <StackPanel Spacing="10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Theme="{StaticResource LinkButton}" Classes="primary update-chip" Content="下载"
                        IsVisible="{Binding CanDownloadUpdate}"
                        Command="{Binding DownloadUpdateCommand}" />
                <Button Theme="{StaticResource LinkButton}" Classes="primary update-chip" Content="打开发布页"
                        IsVisible="{Binding NeedsUpdatePage}"
                        Command="{Binding OpenUpdateCommand}" />
                <Button Theme="{StaticResource LinkButton}" Classes="primary update-chip" Content="{Binding UpdateInstallButtonText}"
                        IsVisible="{Binding IsUpdateReady}"
                        Command="{Binding InstallUpdateCommand}" />
                <Button Theme="{StaticResource LinkButton}" Classes="update-chip" Content="取消"
                        IsVisible="{Binding IsDownloadingUpdate}"
                        Command="{Binding CancelUpdateDownloadCommand}" />
                <Button Theme="{StaticResource LinkButton}" Classes="update-chip" Content="忽略"
                        IsVisible="{Binding !IsDownloadingUpdate}"
                        Command="{Binding DismissUpdateCommand}" />
              </StackPanel>
              <Path DockPanel.Dock="Left" Data="{Binding UpdateIconGlyph}"
                    Width="16" Height="16" Stretch="Uniform"
                    Stroke="{Binding UpdateIconBrush}" StrokeThickness="1.8"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding UpdateDisplayText}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text=" · " FontSize="12" VerticalAlignment="Center"
                           IsVisible="{Binding UpdateNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding UpdateNoteText}" FontSize="11" VerticalAlignment="Center" Foreground="{Binding TextDimBrush}"
                           IsVisible="{Binding UpdateNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DockPanel>
            <ProgressBar Height="4" MinHeight="4" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"
                         IsVisible="{Binding IsDownloadingUpdate}" />
          </StackPanel>
        </Border>

        <!-- 竖排更新胶囊（原型 .update-pill）：只占图标宽度，点击弹出更新卡片 -->
        <Button Name="UpdatePillButton" Margin="0,2,0,0"
                Classes="update-pill"
                IsVisible="{Binding ShowUpdatePill}"
                HorizontalAlignment="Center"
                Click="OnUpdatePillClick"
                ToolTip.Tip="发现新版本，点击查看">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Classes="pill-dot" Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{Binding AccentBrush}" />
            <TextBlock Text="新版本" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- 编辑模式工具条（原型 .dock-editbar：border-top 通宽、提示居左、chip 靠右、padding 4,8,0） -->
        <StackPanel IsVisible="{Binding IsEditMode}" Margin="0,2,0,0">
          <Border Height="1" Background="{Binding PanelBorderBrush}" />
          <DockPanel Margin="8,4,8,0">
            <Button DockPanel.Dock="Right"
                    Theme="{StaticResource LinkButton}" Classes="primary" Content="完成"
                    Command="{Binding ToggleEditCommand}" VerticalAlignment="Center" />
            <TextBlock Name="EditHint"
                       IsVisible="{Binding !IsVertical}"
                       Text="拖动排序 · 双击改名 · × 移除"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{Binding TextDimBrush}" />
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
