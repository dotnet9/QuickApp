<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://codewf.com"
        xmlns:q="clr-namespace:QuickApp.Core.I18n;assembly=QuickApp.Core"
        xmlns:codewf="https://codewf.com"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        xmlns:icons="clr-namespace:QuickApp.Theme"
        xmlns:ursa="https://irihi.tech/ursa"
        x:Class="QuickApp.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{l:I18n {x:Static q:Language.SettingsTitle}}"
        Width="720"
        Height="620"
        CanResize="True"
        MinWidth="720" MinHeight="540"
        ShowInTaskbar="True"
        WindowCornerRadius="14"
        WindowStartupLocation="CenterScreen"
        Background="{Binding BackgroundBrush}"
        BorderBrush="{Binding PanelBorderBrush}"
        BorderThickness="1"
        TitleBarForeground="{Binding TextBrush}">
  <codewf:CodeWFWindow.RightContent>
    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,0" VerticalAlignment="Center">
      <ListBox Classes="title-palettes" ItemsSource="{Binding PaletteOptions}" SelectedItem="{Binding SelectedPalette}" Height="28" Padding="0" BorderThickness="0" Background="Transparent" ToolTip.Tip="{l:I18n {x:Static q:Language.Palette}}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:AppearanceOption"><Ellipse Width="14" Height="14" Fill="{Binding Swatch}" ToolTip.Tip="{Binding Text}" AutomationProperties.Name="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ThemeVariantScope x:Name="TitleBarThemeScope" RequestedThemeVariant="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
        <ThemeVariantScope.Resources>
          <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{l:I18n {x:Static q:Language.SystemTheme}}" />
          <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{l:I18n {x:Static q:Language.LightTheme}}" />
          <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{l:I18n {x:Static q:Language.DarkTheme}}" />
        </ThemeVariantScope.Resources>
        <ursa:ThemeToggleButton Width="30" Height="30" IsThreeState="True" TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{l:I18n {x:Static q:Language.Theme}}" />
      </ThemeVariantScope>
      <Button Width="30" Height="30" Padding="6" Background="Transparent" ToolTip.Tip="{l:I18n {x:Static q:Language.InterfaceLanguage}}" AutomationProperties.Name="{l:I18n {x:Static q:Language.InterfaceLanguage}}">
        <PathIcon Width="17" Height="17" Data="{StaticResource SemiIconLanguage}" />
        <Button.Flyout><MenuFlyout ItemsSource="{Binding LanguageOptions}"><MenuFlyout.ItemContainerTheme>
          <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:AppearanceOption"><Setter Property="Header" Value="{Binding Text}" /><Setter Property="Command" Value="{Binding SelectCommand}" /></ControlTheme>
        </MenuFlyout.ItemContainerTheme></MenuFlyout></Button.Flyout>
      </Button>
    </StackPanel>
  </codewf:CodeWFWindow.RightContent>

  <!--
    与原型 design/index.html 的 .settings-* 逐项对齐：
    导航 136px 背景+右缘线、标签 38px 高选中强调色带左缘缺口条、
    行 min-height 34 左标签（可带 11px 行内说明）右控件、分组 h3 12px 淡色。
  -->
  <Window.Styles>
    <Style Selector="ListBox.title-palettes ListBoxItem"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="4" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="ListBox.title-palettes ListBoxItem:selected"><Setter Property="BorderBrush" Value="{DynamicResource QAAccentBrush}" /></Style>
    <Style Selector="Slider">
      <Setter Property="Width" Value="130" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.row">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button.data-action">
      <Setter Property="Margin" Value="0,0,12,8" />
    </Style>
    <Style Selector="TextBlock.output">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Width" Value="46" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="MaxWidth" Value="210" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
    </Style>
    <!-- 关于页链接：原型 .about-url 强调色文字，无底色 -->
    <Style Selector="Button.about-url">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.about-url:pointerover">
      <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style Selector="TabControl.settings-tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.groupsep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource QALineBrush}" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Border.tab-content">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="18,4,18,18" />
    </Style>
    <!-- 推荐 · 卡片（原型 .rec-card） -->
    <Style Selector="ItemsControl.rec-list">
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style Selector="Border.rec-card">
      <Setter Property="Padding" Value="14,13" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource QAResultRowBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.rec-icon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7" />
    </Style>
    <Style Selector="TextBlock.rec-title">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="Border.rec-ver">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderBrush" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="TextBlock.rec-ver">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.rec-desc">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.rec-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="ProgressBar.rec-progress">
      <Setter Property="Height" Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource QAActiveBrush}" />
    </Style>
    <Style Selector="Border.rec-badge">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderBrush" Value="#663FB96F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.rec-badge">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3FB96F" />
    </Style>
    <!-- 推荐 · 安装按钮（强调色实底，原型 .chip.primary） -->
    <Style Selector="Button.rec-install">
      <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
      <Setter Property="Background" Value="{DynamicResource QAPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentInkBrush}" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
  </Window.Styles>

  <DockPanel>
        <!-- 导航区背景/右缘线画在下层，标签自身透明（原型 .settings-nav） -->
        <Grid>
          <Grid ColumnDefinitions="156,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource QAHoverBrush}"
                    BorderBrush="{DynamicResource QALineBrush}"
                    BorderThickness="0,0,1,0" />
          </Grid>
          <TabControl Name="SettingsTabs"
                      TabStripPlacement="Left"
                      Classes="settings-tabs"
                      Margin="0">
            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Gear}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="{l:I18n {x:Static q:Language.General}}" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="{l:I18n {x:Static q:Language.StartupDisplay}}" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.AutoStart}}" />
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding AutoStartEnabled}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.RevealOnHover}}" />
                        <TextBlock Classes="hint" Text="{l:I18n {x:Static q:Language.RevealHint}}" VerticalAlignment="Center" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding RevealOnEdgeTouch}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Monitor}}" />
                      <ComboBox Grid.Column="1"
                                ItemsSource="{Binding MonitorOptions}"
                                SelectedItem="{Binding SelectedMonitor}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:MonitorOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,2,0,0"
                               Text="{l:I18n {x:Static q:Language.MonitorHint}}" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.AutoHideDelay}}" />
                      <Slider Grid.Column="1" Margin="0,0,12,0"
                              Minimum="0" Maximum="2000" TickFrequency="100" Value="{Binding AutoHideDelayMs}" />
                      <TextBlock Grid.Column="2" Classes="output" Text="{Binding AutoHideDelayText}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.CollapseAfterLaunch}}" />
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding CollapseAfterLaunch}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.CheckAtStartup}}" />
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding CheckUpdates}" />
                    </Grid>
                    <Border Classes="groupsep" />
                    <TextBlock Classes="section" Text="{l:I18n {x:Static q:Language.Keyboard}}" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.GlobalHotkey}}" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center"
                                 Text="{Binding HotkeyText}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,3,0,0"
                               Text="{l:I18n {x:Static q:Language.KeyboardHint}}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Application}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="{l:I18n {x:Static q:Language.Appearance}}" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="{l:I18n {x:Static q:Language.InterfaceDisplay}}" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Style}}" />
                      <Border Grid.Column="1" Background="{DynamicResource QAHoverBrush}" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Theme="{StaticResource Segment}" Content="{l:I18n {x:Static q:Language.Glass}}" Classes.active="{Binding IsStyleGlass}" Command="{Binding SetStyleCommand}" CommandParameter="glass" />
                          <Button Theme="{StaticResource Segment}" Content="{l:I18n {x:Static q:Language.Flat}}" Classes.active="{Binding IsStyleFlat}" Command="{Binding SetStyleCommand}" CommandParameter="flat" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.IconLabels}}" />
                      <Border Grid.Column="1" Background="{DynamicResource QAHoverBrush}" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Theme="{StaticResource Segment}" Content="{l:I18n {x:Static q:Language.IconsOnly}}"
                                  Classes.active="{Binding IsLabelsOnly}"
                                  Command="{Binding SetLabelsCommand}" CommandParameter="icon" />
                          <Button Theme="{StaticResource Segment}" Content="{l:I18n {x:Static q:Language.IconAndName}}"
                                  Classes.active="{Binding IsLabelsWithText}"
                                  Command="{Binding SetLabelsCommand}" CommandParameter="iconText" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.IconSize}}" />
                      <Slider Grid.Column="1" Margin="0,0,12,0"
                              Minimum="32" Maximum="64" TickFrequency="2" Value="{Binding TileSize}" />
                      <TextBlock Grid.Column="2" Classes="output" Text="{Binding TileSize}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.PanelRadius}}" />
                      <Slider Grid.Column="1" Margin="0,0,12,0"
                              Minimum="8" Maximum="32" TickFrequency="1" Value="{Binding CornerRadius}" />
                      <TextBlock Grid.Column="2" Classes="output" Text="{Binding CornerRadius}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,3,0,0" Text="{l:I18n {x:Static q:Language.GlassFallback}}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Database}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="{l:I18n {x:Static q:Language.Data}}" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="{l:I18n {x:Static q:Language.Configuration}}" />
                    <Grid Classes="row" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.ConfigLocation}}" />
                      <TextBlock Grid.Column="1" Classes="hint"
                                 Text="{Binding ConfigFilePath}" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.StorageLocation}}" />
                      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding StorageModeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                    <Button Theme="{StaticResource LinkButton}" Name="StorageModeButton" HorizontalAlignment="Left"
                            Content="{Binding StorageModeSwitchText}" />
                    <TextBlock Name="StorageModeResultText" Classes="hint" Margin="0,3,0,0" IsVisible="False" />
                    <TextBlock Classes="hint" Margin="0,3,0,0" Text="{l:I18n {x:Static q:Language.ImportWarning}}" />
                    <TextBlock Classes="hint" Text="{Binding ConfigLoadStatus}" TextWrapping="Wrap" IsVisible="{Binding HasConfigLoadError}" Foreground="{Binding DangerBrush}" />
                    <WrapPanel Margin="0,10,0,0">
                      <Button Classes="data-action" Theme="{StaticResource LinkButton}" Name="ImportButton" Content="{l:I18n {x:Static q:Language.ImportConfig}}" />
                      <Button Classes="data-action" Theme="{StaticResource LinkButton}" Name="ExportButton" Content="{l:I18n {x:Static q:Language.ExportConfig}}" />
                      <Button Classes="data-action" Theme="{StaticResource LinkButton}" Name="OpenConfigFolderButton" Content="{l:I18n {x:Static q:Language.OpenConfigFolder}}" />
                      <Button Classes="data-action" Theme="{StaticResource LinkButton}" Name="ReloadConfigButton" Content="{l:I18n {x:Static q:Language.ReloadConfig}}" />
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Rocket}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="{l:I18n {x:Static q:Language.Recommended}}" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="{l:I18n {x:Static q:Language.RecommendedApps}}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="{l:I18n {x:Static q:Language.RecommendedHint}}" />
                    <ItemsControl Classes="rec-list" ItemsSource="{Binding RecommendedApps.Cards}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecommendedAppCardViewModel">
                          <Border Classes="rec-card">
                            <StackPanel Spacing="10">
                              <Grid ColumnDefinitions="Auto,*,Auto" >
                                <Border Grid.Column="0" Classes="rec-icon" Margin="0,0,12,0">
                                  <Image Source="{Binding Icon}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                  <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Classes="rec-title" Text="{Binding DisplayName}" />
                                    <Border Classes="rec-ver" IsVisible="{Binding LatestTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <TextBlock Classes="rec-ver" Text="{Binding VersionBadge}" />
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Classes="rec-desc" Text="{Binding Description}" />
                                  <TextBlock Classes="rec-meta" Text="{Binding MetaText}" IsVisible="{Binding MetaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                              </Grid>
                              <!-- 下载/安装中：进度条 + 取消 -->
                              <StackPanel IsVisible="{Binding IsDownloading}" Spacing="6">
                                <ProgressBar Classes="rec-progress" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}" />
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                  <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                                             Text="{Binding InstallHint}" />
                                  <TextBlock Grid.Column="1" Classes="rec-meta" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Text="{Binding DownloadProgress, StringFormat={}{0:0}%}" />
                                  <Button Grid.Column="2" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.Cancel}}" Command="{Binding CancelCommand}" />
                                </Grid>
                              </StackPanel>
                              <StackPanel IsVisible="{Binding IsInstalling}" Spacing="6">
                                <ProgressBar Classes="rec-progress" IsIndeterminate="True" />
                                <TextBlock Classes="hint" Text="{Binding InstallingHint}" />
                              </StackPanel>
                              <!-- 常态：安装 / 已装徽标 + Dock 开关 / 发布页 -->
                              <StackPanel IsVisible="{Binding IsIdle}" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <TextBlock Classes="hint" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Text="{Binding Error}"
                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button Classes="rec-install" Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
                                <Button Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.ReleasePage}}" Command="{Binding OpenReleasePageCommand}" />
                              </StackPanel>
                              <StackPanel IsVisible="{Binding IsResolving}" HorizontalAlignment="Right">
                                <TextBlock Classes="hint" Text="{l:I18n {x:Static q:Language.Resolving}}" />
                              </StackPanel>
                              <StackPanel IsVisible="{Binding IsInstalled}" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Border Classes="rec-badge">
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Data="{x:Static icons:Icons.Check}" Stroke="#3FB96F" StrokeThickness="2.4"
                                          StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                                    <TextBlock Classes="rec-badge" Text="{l:I18n {x:Static q:Language.Installed}}" />
                                  </StackPanel>
                                </Border>
                                <Button Theme="{StaticResource LinkButton}" Content="{Binding DockButtonText}" Command="{Binding ToggleDockCommand}" />
                                <Button Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.ReleasePage}}" Command="{Binding OpenReleasePageCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="{l:I18n {x:Static q:Language.RecommendedFooter}}" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Info}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="{l:I18n {x:Static q:Language.About}}" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,14">
                      <Border Width="48" Height="48" CornerRadius="14" ClipToBounds="True" BoxShadow="0 4 12 0 #38000000">
                        <Image Width="48" Height="48" Source="avares://QuickApp/Assets/logo.png" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="QuickApp" FontSize="16" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Classes="hint" FontSize="12" Text="{l:I18n {x:Static q:Language.AppDescription}}" />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="groupsep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Version}}" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{Binding VersionText}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Platform}}" />
                      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding PlatformText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.BuildTime}}" />
                      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding BuildTimeText}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Purpose}}" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{l:I18n {x:Static q:Language.PurposeDescription}}" TextWrapping="Wrap" />
                    </Grid>
                    <Border Classes="groupsep" />
                    <TextBlock Classes="section" Text="{l:I18n {x:Static q:Language.ProjectInfo}}" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Author}}" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{l:I18n {x:Static q:Language.AuthorName}}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Website}}" />
                      <Button Grid.Column="1" Classes="about-url" Name="WebsiteButton" Content="https://codewf.com" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Repository}}" />
                      <Button Grid.Column="1" Classes="about-url" Name="RepoButton" Content="https://github.com/dotnet9/QuickApp" />
                    </Grid>
                    <Border Classes="groupsep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.CheckUpdates}}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Theme="{StaticResource LinkButton}" Name="UpdateDetailsButton" Content="{l:I18n {x:Static q:Language.ViewNewVersion}}"
                                IsVisible="{Binding Dock.UpdateAvailable}" Command="{Binding Dock.ShowUpdateNotesCommand}" />
                        <Button Name="CheckUpdateButton" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.CheckNow}}" Command="{Binding CheckUpdateCommand}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,3,0,0"
                               Text="{Binding Dock.UpdateResultText}"
                               IsVisible="{Binding Dock.UpdateResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                      <Button Theme="{StaticResource LinkButton}" Name="LicenseButton" Content="{l:I18n {x:Static q:Language.License}}" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>
          </TabControl>
        </Grid>
      </DockPanel>
</codewf:CodeWFWindow>
