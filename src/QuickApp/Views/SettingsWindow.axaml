<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        xmlns:icons="clr-namespace:QuickApp.Theme"
        x:Class="QuickApp.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="QuickApp 设置"
        Width="732"
        Height="560"
        CanResize="False"
        ShowInTaskbar="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent">

  <!--
    与原型 design/index.html 的 .settings-* 逐项对齐：
    导航 136px 背景+右缘线、标签 38px 高选中强调色带左缘缺口条、
    行 min-height 34 左标签（可带 11px 行内说明）右控件、分组 h3 12px 淡色。
  -->
  <Window.Styles>
    <Style Selector="Slider">
      <Setter Property="Width" Value="130" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.row">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBlock.output">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Width" Value="46" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="MaxWidth" Value="210" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
    </Style>
    <!-- 关于页链接：原型 .about-url 强调色文字，无底色 -->
    <Style Selector="Button.about-url">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.about-url:pointerover">
      <Setter Property="Opacity" Value="0.78" />
    </Style>
    <Style Selector="TabControl.settings-tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.groupsep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource QALineBrush}" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Border.tab-content">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="18,4,18,18" />
    </Style>
    <!-- 推荐 · 卡片（原型 .rec-card） -->
    <Style Selector="ItemsControl.rec-list">
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style Selector="Border.rec-card">
      <Setter Property="Padding" Value="14,13" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.rec-icon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7" />
    </Style>
    <Style Selector="TextBlock.rec-title">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
    <Style Selector="Border.rec-ver">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderBrush" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="TextBlock.rec-ver">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.rec-desc">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.rec-meta">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource QATextDimBrush}" />
    </Style>
    <Style Selector="ProgressBar.rec-progress">
      <Setter Property="Height" Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource QAActiveBrush}" />
    </Style>
    <Style Selector="Border.rec-badge">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BorderBrush" Value="#663FB96F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.rec-badge">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#3FB96F" />
    </Style>
    <!-- 推荐 · 安装按钮（强调色实底，原型 .chip.primary） -->
    <Style Selector="Button.rec-install">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QAAccentInkBrush}" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Button.rec-install:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource QAAccentBrush}" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>
  </Window.Styles>

  <!-- 透明边距 10px（浅色桌面减少透出）——原型阴影 18/40 超出该投影区，按比例衰减为 12/28，色值同 0.45/0.35 -->
  <Grid Margin="10">
    <Border Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            BoxShadow="0 12 28 0 #66000000, 0 2 6 0 #44000000">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <Border Name="HeaderBar"
                  Background="Transparent"
                  Padding="16,14"
                  Cursor="SizeAll">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="设置"
                         FontSize="14"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{Binding TextBrush}" />
              <Button Grid.Column="1"
                      Theme="{StaticResource IconButton}"
                      Name="CloseButton"
                      Width="32"
                      Height="32"
                      ToolTip.Tip="关闭">
                <Path Data="{x:Static icons:Icons.Close}"
                      Stroke="{Binding TextDimBrush}"
                      StrokeThickness="1.75"
                      StrokeLineCap="Round"
                      Width="20"
                      Height="20"
                      Stretch="Uniform" />
              </Button>
            </Grid>
          </Border>
          <Border Height="1" Background="{Binding PanelBorderBrush}" />
        </StackPanel>

        <!-- 导航区背景/右缘线画在下层，标签自身透明（原型 .settings-nav） -->
        <Grid>
          <Grid ColumnDefinitions="136,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource QAHoverBrush}"
                    BorderBrush="{DynamicResource QALineBrush}"
                    BorderThickness="0,0,1,0" />
          </Grid>
          <TabControl Name="SettingsTabs"
                      TabStripPlacement="Left"
                      Classes="settings-tabs"
                      Margin="0">
            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Gear}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="常规" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="启动与显示" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="开机启动" />
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding AutoStartEnabled}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Classes="row" Text="悬停唤出" />
                        <TextBlock Classes="hint" Text="停留片刻后展开 Dock" VerticalAlignment="Center" />
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding RevealOnEdgeTouch}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="目标显示器" />
                      <ComboBox Grid.Column="1"
                                ItemsSource="{Binding MonitorOptions}"
                                SelectedItem="{Binding SelectedMonitor}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:MonitorOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,2,0,0"
                               Text="Dock 只存在于所选显示器：停靠、收起、唤出把手都在它上面，切换后整体迁移；显示器被拔掉时回落主显示器" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="row" Text="自动隐藏延时" />
                      <Slider Grid.Column="1" Margin="0,0,12,0"
                              Minimum="0" Maximum="2000" TickFrequency="100" Value="{Binding AutoHideDelayMs}" />
                      <TextBlock Grid.Column="2" Classes="output" Text="{Binding AutoHideDelayText}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="运行后收起" />
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding CollapseAfterLaunch}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="自动检查更新（启动时及每 12 小时）" />
                      <ToggleButton Grid.Column="1" Classes="switch" IsChecked="{Binding CheckUpdates}" />
                    </Grid>
                    <Border Classes="groupsep" />
                    <TextBlock Classes="section" Text="快捷键" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="全局唤起" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center"
                                 Text="{Binding HotkeyText, StringFormat=固定：{0}}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,3,0,0"
                               Text="← → ↑ ↓ 移动 · Enter 运行 · 1–9 快速启动 · S / Ctrl+K 搜索 · E 编辑 · Esc 关闭" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Application}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="外观" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="界面与显示" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="主题" />
                      <Border Grid.Column="1" Background="{DynamicResource QAHoverBrush}" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Theme="{StaticResource Segment}" Content="跟随系统" Classes.active="{Binding IsThemeSystem}" Command="{Binding SetThemeCommand}" CommandParameter="system" />
                          <Button Theme="{StaticResource Segment}" Content="深色" Classes.active="{Binding IsThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="dark" />
                          <Button Theme="{StaticResource Segment}" Content="浅色" Classes.active="{Binding IsThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="light" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="风格" />
                      <Border Grid.Column="1" Background="{DynamicResource QAHoverBrush}" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Theme="{StaticResource Segment}" Content="毛玻璃" Classes.active="{Binding IsStyleGlass}" Command="{Binding SetStyleCommand}" CommandParameter="glass" />
                          <Button Theme="{StaticResource Segment}" Content="扁平" Classes.active="{Binding IsStyleFlat}" Command="{Binding SetStyleCommand}" CommandParameter="flat" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="图标标签" />
                      <Border Grid.Column="1" Background="{DynamicResource QAHoverBrush}" CornerRadius="9" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <Button Theme="{StaticResource Segment}" Content="仅图标"
                                  Classes.active="{Binding IsLabelsOnly}"
                                  Command="{Binding SetLabelsCommand}" CommandParameter="icon" />
                          <Button Theme="{StaticResource Segment}" Content="图标 + 名称"
                                  Classes.active="{Binding IsLabelsWithText}"
                                  Command="{Binding SetLabelsCommand}" CommandParameter="iconText" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="row" Text="图标尺寸" />
                      <Slider Grid.Column="1" Margin="0,0,12,0"
                              Minimum="32" Maximum="64" TickFrequency="2" Value="{Binding TileSize}" />
                      <TextBlock Grid.Column="2" Classes="output" Text="{Binding TileSize}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Classes="row" Text="面板圆角" />
                      <Slider Grid.Column="1" Margin="0,0,12,0"
                              Minimum="8" Maximum="32" TickFrequency="1" Value="{Binding CornerRadius}" />
                      <TextBlock Grid.Column="2" Classes="output" Text="{Binding CornerRadius}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,3,0,0" Text="毛玻璃在部分系统上可能退化为纯色" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Database}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="数据" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="配置" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="配置文件位置" />
                      <TextBlock Grid.Column="1" Classes="hint" MaxWidth="400"
                                 Text="{Binding ConfigFilePath}" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Classes="row" Text="存储位置" />
                        <TextBlock Classes="hint" Text="{Binding StorageModeText}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Name="StorageModeButton"
                              Content="{Binding StorageModeSwitchText}" />
                    </Grid>
                    <TextBlock Name="StorageModeResultText" Classes="hint" Margin="0,3,0,0" IsVisible="False" />
                    <TextBlock Classes="hint" Margin="0,3,0,0" Text="导入配置会替换当前的快捷项与设置" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                      <Button Theme="{StaticResource LinkButton}" Name="ImportButton" Content="导入配置" />
                      <Button Theme="{StaticResource LinkButton}" Name="ExportButton" Content="导出配置" />
                      <Button Theme="{StaticResource LinkButton}" Name="OpenConfigFolderButton" Content="打开配置文件夹" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Rocket}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="推荐" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Classes="section" Text="推荐应用" />
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="精选作者自研软件，一键下载并安装（安装包实时取自各仓库 GitHub Releases 最新发布，附 sha256 校验）；安装完成后自动把快捷方式加入 Dock，可随时在编辑模式移除。" />
                    <ItemsControl Classes="rec-list" ItemsSource="{Binding RecommendedApps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecommendedAppCardViewModel">
                          <Border Classes="rec-card">
                            <StackPanel Spacing="10">
                              <Grid ColumnDefinitions="Auto,*,Auto" >
                                <Border Grid.Column="0" Classes="rec-icon" Margin="0,0,12,0">
                                  <Image Source="{Binding Icon}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                  <StackPanel Orientation="Horizontal" Spacing="0">
                                    <TextBlock Classes="rec-title" Text="{Binding DisplayName}" />
                                    <Border Classes="rec-ver" IsVisible="{Binding LatestTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                      <TextBlock Classes="rec-ver" Text="{Binding VersionBadge}" />
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Classes="rec-desc" Text="{Binding Description}" />
                                  <TextBlock Classes="rec-meta" Text="{Binding MetaText}" IsVisible="{Binding MetaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                              </Grid>
                              <!-- 下载/安装中：进度条 + 取消 -->
                              <StackPanel IsVisible="{Binding IsDownloading}" Spacing="6">
                                <ProgressBar Classes="rec-progress" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}" />
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                  <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                                             Text="{Binding InstallHint}" />
                                  <TextBlock Grid.Column="1" Classes="rec-meta" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Text="{Binding DownloadProgress, StringFormat={}{0:0}%}" />
                                  <Button Grid.Column="2" Theme="{StaticResource LinkButton}" Content="取消" Command="{Binding CancelCommand}" />
                                </Grid>
                              </StackPanel>
                              <StackPanel IsVisible="{Binding IsInstalling}" Spacing="6">
                                <ProgressBar Classes="rec-progress" IsIndeterminate="True" />
                                <TextBlock Classes="hint" Text="{Binding InstallingHint}" />
                              </StackPanel>
                              <!-- 常态：安装 / 已装徽标 + Dock 开关 / 发布页 -->
                              <StackPanel IsVisible="{Binding IsIdle}" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <TextBlock Classes="hint" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Text="{Binding Error}"
                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button Classes="rec-install" Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
                                <Button Theme="{StaticResource LinkButton}" Content="发布页" Command="{Binding OpenReleasePageCommand}" />
                              </StackPanel>
                              <StackPanel IsVisible="{Binding IsResolving}" HorizontalAlignment="Right">
                                <TextBlock Classes="hint" Text="正在获取最新版本…" />
                              </StackPanel>
                              <StackPanel IsVisible="{Binding IsInstalled}" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Border Classes="rec-badge">
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Data="{x:Static icons:Icons.Check}" Stroke="#3FB96F" StrokeThickness="2.4"
                                          StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                                    <TextBlock Classes="rec-badge" Text="已安装" />
                                  </StackPanel>
                                </Border>
                                <Button Theme="{StaticResource LinkButton}" Content="{Binding DockButtonText}" Command="{Binding ToggleDockCommand}" />
                                <Button Theme="{StaticResource LinkButton}" Content="发布页" Command="{Binding OpenReleasePageCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="推荐列表随应用版本更新 · 全部作品见 doc.codewf.com" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>

            <TabItem Classes="settings-tab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="tab-icon"
                        Data="{x:Static icons:Icons.Info}"
                        StrokeThickness="1.75"
                        Width="16"
                        Height="16"
                        Stretch="Uniform" />
                  <TextBlock Text="关于" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <Border Classes="tab-content">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,20,0,14">
                      <Border Width="48" Height="48" CornerRadius="14" ClipToBounds="True" BoxShadow="0 4 12 0 #38000000">
                        <Image Width="48" Height="48" Source="avares://QuickApp/Assets/logo.png" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="QuickApp" FontSize="16" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Classes="hint" FontSize="12" Text="快捷应用启动器" />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="groupsep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="版本" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="{Binding VersionText}" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="定位" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="快速打开应用、网页与命令" />
                    </Grid>
                    <Border Classes="groupsep" />
                    <TextBlock Classes="section" Text="项目信息" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="作者" />
                      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="沙漠尽头的狼" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="官方网站" />
                      <Button Grid.Column="1" Classes="about-url" Name="WebsiteButton" Content="https://codewf.com" />
                    </Grid>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="仓库地址" />
                      <Button Grid.Column="1" Classes="about-url" Name="RepoButton" Content="https://github.com/dotnet9/QuickApp" />
                    </Grid>
                    <Border Classes="groupsep" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="row" Text="检查更新" />
                      <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Content="立即检查" Command="{Binding CheckUpdateCommand}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="0,3,0,0"
                               Text="{Binding CheckResult}"
                               IsVisible="{Binding CheckResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                      <Button Theme="{StaticResource LinkButton}" Name="LicenseButton" Content="许可证" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </TabItem>
          </TabControl>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
