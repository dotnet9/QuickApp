<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="QuickApp 设置"
        Width="480"
        Height="640"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{Binding BackgroundBrush}">

  <Window.Styles>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="18,12,18,18" Spacing="2">

      <TextBlock Classes="section" Text="常规" />
      <CheckBox Content="鼠标触到所在边缘时滑出" IsChecked="{Binding RevealOnEdgeTouch}" />
      <CheckBox Content="钉住（不自动隐藏）" IsChecked="{Binding Pinned}" />
      <CheckBox Content="执行一个项目后自动收起" IsChecked="{Binding CollapseAfterLaunch}" />
      <CheckBox Content="开机启动" IsChecked="{Binding AutoStartEnabled}" />
      <Grid ColumnDefinitions="160,*" Margin="0,6,0,0">
        <TextBlock Grid.Column="0" Classes="row" Text="自动隐藏延时" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Slider Minimum="0" Maximum="3000" TickFrequency="100" Value="{Binding AutoHideDelayMs}" />
          <TextBlock Classes="row" Width="60" Text="{Binding AutoHideDelayMs}" />
        </StackPanel>
      </Grid>

      <TextBlock Classes="section" Text="外观" />
      <Grid ColumnDefinitions="160,*">
        <TextBlock Grid.Column="0" Classes="row" Text="主题" />
        <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex}">
          <ComboBoxItem>跟随系统</ComboBoxItem>
          <ComboBoxItem>深色</ComboBoxItem>
          <ComboBoxItem>浅色</ComboBoxItem>
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="160,*">
        <TextBlock Grid.Column="0" Classes="row" Text="风格" />
        <ComboBox Grid.Column="1" SelectedIndex="{Binding StyleIndex}">
          <ComboBoxItem>毛玻璃</ComboBoxItem>
          <ComboBoxItem>扁平</ComboBoxItem>
        </ComboBox>
      </Grid>
      <CheckBox Content="在图标下显示名称" IsChecked="{Binding ShowLabels}" />
      <Grid ColumnDefinitions="160,*" Margin="0,6,0,0">
        <TextBlock Grid.Column="0" Classes="row" Text="图标尺寸" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Slider Minimum="28" Maximum="72" TickFrequency="2" Value="{Binding TileSize}" />
          <TextBlock Classes="row" Width="60" Text="{Binding TileSize}" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="160,*" Margin="0,6,0,0">
        <TextBlock Grid.Column="0" Classes="row" Text="面板圆角" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Slider Minimum="0" Maximum="32" TickFrequency="1" Value="{Binding CornerRadius}" />
          <TextBlock Classes="row" Width="60" Text="{Binding CornerRadius}" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="160,*" Margin="0,6,0,0">
        <TextBlock Grid.Column="0" Classes="row" Text="面板不透明度" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Slider Minimum="20" Maximum="100" TickFrequency="1" Value="{Binding OpacityPercent}" />
          <TextBlock Classes="row" Width="60" Text="{Binding OpacityPercent}" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="hint" Text="毛玻璃在部分系统或 Avalonia 后端上会退化成纯色，此时请把不透明度调到 100%。" />

      <TextBlock Classes="section" Text="停靠" />
      <Grid ColumnDefinitions="160,*">
        <TextBlock Grid.Column="0" Classes="row" Text="停靠边缘" />
        <ComboBox Grid.Column="1" SelectedIndex="{Binding EdgeIndex}">
          <ComboBoxItem>上边缘</ComboBoxItem>
          <ComboBoxItem>下边缘</ComboBoxItem>
          <ComboBoxItem>左边缘（竖向）</ComboBoxItem>
          <ComboBoxItem>右边缘（竖向）</ComboBoxItem>
        </ComboBox>
      </Grid>

      <TextBlock Classes="section" Text="数据" />
      <Grid ColumnDefinitions="160,*">
        <TextBlock Grid.Column="0" Classes="row" Text="配置文件" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Classes="hint" Text="{Binding ConfigFilePath}" />
          <Button Classes="link" Content="打开所在目录" HorizontalAlignment="Left"
                  Command="{Binding OpenConfigFolderCommand}" CommandParameter="{Binding ConfigFilePath}" />
        </StackPanel>
      </Grid>
      <StackPanel Spacing="4" Margin="0,6,0,0">
        <TextBlock Classes="row" Text="添加命令行" />
        <TextBox Name="CmdName" PlaceholderText="名称，例如 远程桌面" />
        <TextBox Name="CmdValue" PlaceholderText="命令，例如 mstsc /v:192.168.1.133" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="AddCmdButton" Content="添加命令行" />
          <Button Name="AddFileButton" Content="添加文件…" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="section" Text="更新" />
      <CheckBox Content="启动时检查更新" IsChecked="{Binding CheckUpdates}" />
      <Grid ColumnDefinitions="160,*">
        <TextBlock Grid.Column="0" Classes="row" Text="{Binding VersionText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="立即检查" Command="{Binding CheckUpdateCommand}" />
          <TextBlock Classes="row" Text="{Binding CheckResult}" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="hint" Text="更新来自 GitHub Releases（dotnet9/QuickApp），发现新版本会在 Dock 上提示。" />

      <TextBlock Classes="section" Text="关于" />
      <TextBlock Classes="hint" Text="QuickApp 快捷应用 · Avalonia + ReactiveUI 重写版" />
      <TextBlock Classes="hint" Text="数据与原型：design/index.html（四边停靠、深浅主题、毛玻璃/扁平）" />
    </StackPanel>
  </ScrollViewer>
</Window>
