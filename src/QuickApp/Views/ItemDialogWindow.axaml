<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://codewf.com"
        xmlns:q="clr-namespace:QuickApp.Core.I18n;assembly=QuickApp.Core"
        xmlns:codewf="https://codewf.com"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.ItemDialogWindow"
        x:DataType="vm:DockViewModel"
        Title="{l:I18n {x:Static q:Language.EditItem}}"
        Width="472"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        IsMinimizeButtonVisible="False"
        WindowCornerRadius="14"
        Background="{Binding SettingsBackgroundBrush}"
        BorderBrush="{Binding PanelBorderBrush}"
        BorderThickness="1"
        TitleBarForeground="{Binding TextBrush}"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
    </Style>
    <Style Selector="TextBlock.row">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource QAHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QALineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QATextBrush}" />
    </Style>
  </Window.Styles>

  <!-- 与设置窗口同一套卡片：整窗透明、实底圆角卡、自绘标题栏（配色直接绑 DockViewModel 的画刷） -->
  <StackPanel Margin="16">
    <ScrollViewer Name="FormScroll" MaxHeight="440" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
          <StackPanel Spacing="6" Margin="0,0,4,0">
            <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Type}}" Foreground="{Binding TextDimBrush}" />
            <ComboBox Name="KindBox" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
            <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Name}}" Foreground="{Binding TextDimBrush}" />
            <TextBox Name="NameBox" PlaceholderText="{l:I18n {x:Static q:Language.GeneratedNameHint}}" />
            <TextBlock Name="TargetLabel" Classes="row" Text="{l:I18n {x:Static q:Language.Target}}" Foreground="{Binding TextDimBrush}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Name="TargetBox" PlaceholderText="{l:I18n {x:Static q:Language.TargetExample}}" />
              <Button Grid.Column="1" Name="BrowseFileButton" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.File}}" Margin="6,0,0,0" />
              <Button Grid.Column="2" Name="BrowseFolderButton" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.Directory}}" Margin="6,0,0,0" />
            </Grid>
            <StackPanel Name="ArgumentsPanel" Spacing="6">
              <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Arguments}}" Foreground="{Binding TextDimBrush}" />
              <TextBox Name="ArgumentsBox" PlaceholderText="{l:I18n {x:Static q:Language.ArgumentsExample}}" />
              <StackPanel Name="InstanceCountPanel" Spacing="6">
                <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.Instances}}" Foreground="{Binding TextDimBrush}" />
                <TextBox Name="InstanceCountBox" PlaceholderText="1" />
                <TextBlock Text="{l:I18n {x:Static q:Language.InstancesHint}}" FontSize="11" Foreground="{Binding TextDimBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <StackPanel Name="WorkingDirectoryPanel" Spacing="6">
              <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.WorkingDirectory}}" Foreground="{Binding TextDimBrush}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="WorkingDirectoryBox" PlaceholderText="{l:I18n {x:Static q:Language.WorkingDirectoryExample}}" />
                <Button Grid.Column="1" Name="BrowseWorkingDirectoryButton" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.Browse}}" Margin="6,0,0,0" />
              </Grid>
            </StackPanel>
            <StackPanel Name="CommandOptions" Spacing="6" IsVisible="False">
              <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.CommandInterpreter}}" Foreground="{Binding TextDimBrush}" />
              <ComboBox Name="ShellBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="CMD" /><ComboBoxItem Content="PowerShell" />
              </ComboBox>
              <CheckBox Name="TerminalBox" Content="{l:I18n {x:Static q:Language.KeepTerminal}}" Foreground="{Binding TextBrush}" />
              <TextBlock Text="{l:I18n {x:Static q:Language.TerminalHint}}" FontSize="11" Foreground="{Binding TextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Name="PlatformNote" Text="{l:I18n {x:Static q:Language.ShellHint}}" FontSize="11" Foreground="{Binding TextDimBrush}" TextWrapping="Wrap" IsVisible="False" />
            <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.ItemHotkey}}" Foreground="{Binding TextDimBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="HotkeyBox" IsReadOnly="True" PlaceholderText="{l:I18n {x:Static q:Language.HotkeyPlaceholder}}" />
              <Button Grid.Column="1" Name="ClearHotkeyButton" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.Clear}}" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Name="HotkeyNote" Text="{l:I18n {x:Static q:Language.HotkeyHint}}" FontSize="11" Foreground="{Binding TextDimBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock Name="ErrorText" TextWrapping="Wrap" FontSize="12" Foreground="{Binding DangerBrush}" IsVisible="False" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Theme="{StaticResource LinkButton}" Name="CancelButton" Content="{l:I18n {x:Static q:Language.Cancel}}" />
          <Button Theme="{StaticResource LinkButton}" Name="SubmitButton" Classes="primary" IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="M5,12.5 L9.5,17 L19,7"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Width="15"
                  Height="15"
                  Stretch="Uniform" />
              <TextBlock Name="SubmitText" Text="{l:I18n {x:Static q:Language.Save}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
</codewf:CodeWFWindow>
