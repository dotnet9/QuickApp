<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="https://codewf.com"
        xmlns:q="clr-namespace:QuickApp.Core.I18n;assembly=QuickApp.Core"
        xmlns:codewf="https://codewf.com"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.UpdateNotesWindow"
        x:DataType="vm:DockViewModel"
        Title="{l:I18n {x:Static q:Language.UpdateAvailable}}"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        IsMinimizeButtonVisible="False"
        WindowCornerRadius="14"
        Background="{Binding SettingsBackgroundBrush}"
        BorderBrush="{Binding PanelBorderBrush}"
        BorderThickness="1"
        TitleBarForeground="{Binding TextBrush}"
        WindowStartupLocation="CenterOwner">

  <!-- 与编辑窗口同一套卡片：整窗透明、实底圆角卡、自绘标题栏（配色直接绑 DockViewModel 的画刷） -->
  <StackPanel Margin="16">
    <StackPanel Spacing="6" Margin="0,8,4,0">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.InstalledVersion}}" Foreground="{Binding TextDimBrush}" />
        <TextBlock Grid.Column="1" Classes="row" HorizontalAlignment="Right"
                   Text="{Binding CurrentVersionText}" Foreground="{Binding TextBrush}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.LatestVersion}}" Foreground="{Binding TextDimBrush}" />
        <TextBlock Grid.Column="1" Classes="row" HorizontalAlignment="Right" FontWeight="SemiBold"
                   Text="{Binding UpdateTag}" Foreground="{Binding AccentBrush}" />
      </Grid>
      <TextBlock Classes="row" Text="{l:I18n {x:Static q:Language.ReleaseNotes}}" Foreground="{Binding TextDimBrush}" Margin="0,8,0,2" />
      <Border CornerRadius="8" Padding="12,10"
              Background="{Binding HoverBrush}" BorderBrush="{Binding PanelBorderBrush}" BorderThickness="1">
        <ScrollViewer Name="NotesScroll" MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock Name="NotesText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{Binding TextBrush}" />
        </ScrollViewer>
      </Border>
      <StackPanel Name="InstallBar" Spacing="6" Margin="0,8,0,0" IsVisible="False">
        <TextBlock Name="ProgressText" FontSize="11" Foreground="{Binding TextDimBrush}" />
        <ProgressBar Name="DownloadBar" Minimum="0" Maximum="100" Height="6" />
      </StackPanel>
      <TextBlock Name="DownloadError" FontSize="11" TextWrapping="Wrap" IsVisible="False"
                 Text="{l:I18n {x:Static q:Language.CannotDownloadHint}}"
                 Foreground="{Binding DangerBrush}" />
      <TextBlock Name="InstallNote" FontSize="11" TextWrapping="Wrap" IsVisible="False"
                 Text="{l:I18n {x:Static q:Language.InstallConfirmHint}}"
                 Foreground="{Binding TextDimBrush}" />
      <TextBlock Name="FallbackNote" FontSize="11" TextWrapping="Wrap" IsVisible="False"
                 Text="{l:I18n {x:Static q:Language.PackageFallbackHint}}"
                 Foreground="{Binding TextDimBrush}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Name="CancelButton" Theme="{StaticResource LinkButton}" Content="{l:I18n {x:Static q:Language.Cancel}}" />
      <Button Name="InstallButton" Theme="{StaticResource LinkButton}" Classes="primary" IsDefault="True" Content="{l:I18n {x:Static q:Language.Install}}" />
    </StackPanel>
  </StackPanel>
</codewf:CodeWFWindow>
