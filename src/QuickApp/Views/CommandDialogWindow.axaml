<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuickApp.ViewModels"
        x:Class="QuickApp.Views.CommandDialogWindow"
        x:DataType="vm:DockViewModel"
        Title="添加命令行"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent">

  <Window.Styles>
    <Style Selector="TextBlock.row">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Styles>

  <!-- 与设置窗口同一套卡片：整窗透明、实底圆角卡、自绘标题栏（配色直接绑 DockViewModel 的画刷） -->
  <Grid Margin="16">
    <Border Name="Card"
            Background="{Binding SettingsBackgroundBrush}"
            BorderBrush="{Binding PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding PanelRadius}">
      <StackPanel Margin="18,0,18,16">

        <Grid ColumnDefinitions="*,Auto" Margin="-18,0,-18,0" Name="HeaderBar" Cursor="SizeAll">
          <TextBlock Grid.Column="0"
                     Text="添加命令行"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Margin="18,12,0,10"
                     VerticalAlignment="Center"
                     Foreground="{Binding TextBrush}" />
          <Button Grid.Column="1"
                  Theme="{StaticResource IconButton}"
                  Name="CloseButton"
                  Width="28"
                  Height="28"
                  Margin="0,8,10,0"
                  ToolTip.Tip="关闭">
            <Path Data="M6,6 L18,18 M18,6 L6,18"
                  Stroke="{Binding TextDimBrush}"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  Width="11"
                  Height="11"
                  Stretch="Uniform" />
          </Button>
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Classes="row" Text="名称" Foreground="{Binding TextDimBrush}" />
          <TextBox Name="NameBox" PlaceholderText="例如：远程桌面" />
          <TextBlock Classes="row" Text="命令" Margin="0,8,0,4" Foreground="{Binding TextDimBrush}" />
          <TextBox Name="CommandBox" PlaceholderText="例如：mstsc /v:192.168.1.133" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Theme="{StaticResource LinkButton}" Name="CancelButton" Content="取消" />
          <Button Theme="{StaticResource LinkButton}" Name="SubmitButton" Content="添加" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
