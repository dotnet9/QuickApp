<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>QuickApp.Core</RootNamespace>
    <AssemblyName>QuickApp.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 推荐应用目录：内嵌随版本发布；安装包地址不在这里，运行时按系统实时解析 -->
    <EmbeddedResource Include="RecommendedApps.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeWF.Toolkit.Core" />
    <PackageReference Include="CodeWF.Toolkit.Lang" />
    <Content Include="I18n/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
